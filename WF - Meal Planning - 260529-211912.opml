        <outline text="&lt;b&gt;Breakfasts&lt;/b&gt;">
          <outline text="Kyle's Overnight Oats" _note="Peanut Butter, Banana, and Oats Breakfast Jar">
            <outline text="Ingredients">
              <outline text="5 Bananas" _note="#Sprouts&#10;" />
              <outline text="---" />
              <outline text="Peanut Butter" _note=" #ALDI #Isle_1 2 Scoops&#10;" />
              <outline text="Oats" _note="#ALDI " />
              <outline text="Cinnamon " _note="#ALDI " />
              <outline text="Honey " _note="#Sprouts " />
              <outline text="Mini Chocolate Chips " _note="#ALDI " />
              <outline text="Splash of Milk " _note="#ALDI " />
              <outline text="Mason Jar &amp; Spoon" />
            </outline>
            <outline text="Directions">
              <outline text="Prep the night before!" />
              <outline text="Mix Banana, Peanut Butter &amp; Honey in mason jar with a butter knife." />
              <outline text="Add Oats, Cinnamon, &amp; Chocolate Chips, mix" />
              <outline text="Pour in a splash of milk" />
              <outline text="Chill overnight" />
            </outline>
            <outline text="#kyles_favorite " />
            <outline text="0 Backlink" />
          </outline>
          <outline text="Ariel Smoothie">
            <outline text="Frozen blackberries and blueberries, almost full, add milk (half way) and yogurt (an inch think at the top)">
              <outline text="Out of milk? Use the creamer as back up." />
            </outline>
          </outline>
          <outline text="Apple Slices in Peanut Butter, Grapes, and Nuts" />
          <outline text="Breakfast Burrito " _note="Warm up frozen burritos + salsa and avocado packs">
            <outline text="Ingredients">
              <outline text="Chorizo" />
              <outline text="Egg whites (half a of a pourable carton)" />
              <outline text="Onions" _note="Finely chopped " />
              <outline text="Bell Peppers" _note="Finely chopped " />
              <outline text="#needsattention " />
              <outline text="10 Tortillas" />
              <outline text="salsa" />
              <outline text="avocado packs" />
            </outline>
            <outline text="Directions">
              <outline text="Chop the onions and bell peppers in the green chopping contraption." />
              <outline text="Drizzle some olive oil in a large pan." />
              <outline text="Cook the chopped mix of onions and peppers, along with the chorizo." />
              <outline text="A few minutes later, add in the egg whites and stir until cooked." />
            </outline>
          </outline>
          <outline text="Cloud Egg Breakfast">
            <outline text="Ingredients">
              <outline text="Eggs" />
              <outline text="Sauce">
                <outline text="Pesto?" />
                <outline text="#needsattention " />
              </outline>
              <outline text="Salad">
                <outline text="Arugula" />
                <outline text="Cherry tomatoes" />
                <outline text="Spinach" />
                <outline text="(Balsamic vinegar)" />
              </outline>
              <outline text="Melons">
                <outline text="Watermelon 🍉 " />
                <outline text="Dino Honeydew 🍈 " />
              </outline>
              <outline text="Multigrain Bread" />
            </outline>
            <outline text="Directions">
              <outline text="Bust out">
                <outline text="2 Eggs (3 for both of us)" />
                <outline text="A bowl" />
                <outline text="Kitchen Aid wisk head" />
              </outline>
              <outline text="Separate egg whites into the Kitchen Aid, pull out egg yolks, don’t break em. Set the yolks aside into a bowl." />
              <outline text="Salt the egg whites and wisk on 6-level for several minutes." />
              <outline text="Pull out small cast iron skillet and oil it up." />
              <outline text="Toast the multigrain bread while you wait for the wisking " />
              <outline text="Speed up the mixer near the end. It’s gotta be stiff, “peaking”" />
              <outline text="Add handful of Parmesan cheese into peaked egg whites. Fold very gently and use spatula thingy to plop two piles into skillet." />
              <outline text="Make a little intention into egg white fluff, and scoop up egg yolk into that hole." />
              <outline text="Place skillet in the oven (near the bottom) at 350 or lower for less than 5 minutes" />
              <outline text="Butter toast" />
              <outline text="Place egg onto plate" />
              <outline text="Add melons to plate" />
              <outline text="Add salad mix to plate" />
              <outline text="Add balsamic vinegar to salad" />
            </outline>
            <outline text="" />
          </outline>
          <outline text="Loaded Huevos Racheros with Roasted Poblano Peppers">
            <outline text="Ingredients" _note="Makes: 4 Servings">
              <outline text="1 poblano pepper" />
              <outline text="1/2 lb fresh chorizo or bulk spicy pork sausage" />
              <outline text="4 cups frozen O'Brien potatoes, thawed" />
              <outline text="1/2 cup shredded pepper jack cheese" />
              <outline text="1 tsp smoked paprika" />
              <outline text="1/2 tsp kosher salt" />
              <outline text="1/2 tsp garlic powder" />
              <outline text="1/2 tsp pepper" />
              <outline text="4 large eggs" />
              <outline text="Salsa, sour cream and minced fresh cilantro" />
            </outline>
            <outline text="Directions" _note="Prep: 15 min + standing  Cook: 20 min">
              <outline text="Place poblano pepper in a 12-in cast-iron or other ovenproof skillet. Broil 4 in from heat, rotating with tongs, until all sides are blistered and blackened, about 5 minutes. Immediately place pepper in a small bowl; let stand, covered, 20 minutes." />
              <outline text="Peel off and discard the charred skin. Remove the stem and seeds. Finely chop the pepper; set aside." />
              <outline text="In the same skillet, cook the chorizo over medium heat until cooked through, 6-8 minutes, breaking into crumbles; drain. Add potatoes; cook and stir until potatoes are tender, 8-10 minutes. Stir in shredded cheese, smoked paprika, kosher salt, garlic powder and pepper." />
              <outline text="With the back of a spoon, make 4 wells in potato mixture. Break an egg in each well. Cook, covered, on medium-low until egg whites are completely set and yolks begin to thicken but are not hard, 5-7 minutes. Serve with reserved roasted pepper, salsa, sour cream and cilantro." />
            </outline>
            <outline text="Source: Taste of Home" />
            <outline text="#mexican " />
            <outline text="" />
          </outline>
          <outline text="Açaí Smoothies ">
            <outline text="Mix in berries pack and smoothie base (into a different bowl)">
              <outline text="Raspberries" />
              <outline text="Grapes" />
              <outline text="Blackberries " />
              <outline text="Strawberries" />
              <outline text="Pumpkin Flax Seed" />
            </outline>
            <outline text="Top with honey 🍯 " />
          </outline>
          <outline text="Açaí Superfood Smoothie Bowls ">
            <outline text="Fill blender with 1/3 up with Strawberries and Bananas (pre-frozen)" />
            <outline text="Add in Açaí Juice" _note="1/3 of 32 oz bottle" />
            <outline text="Add a little more water if not liquidated enough, but it needs to be thicker than a smoothie." />
            <outline text="Pour mix into containers" />
            <outline text="Pour Granola (in side compartment of container)" />
            <outline text="Add in Blackberries/Strawberries/ Blueberries/Raspberries">
              <outline text="Slice strawberries 🍓 " />
              <outline text="Pre-rinsed and combined in a container in the fridge " />
            </outline>
            <outline text="Sprinkle Chia Seeds" />
            <outline text="Drizzle Honey " />
            <outline text="Clean blender" />
          </outline>
          <outline text="Breakfast Tacos">
            <outline text="Egg (Liquid Carton)" />
            <outline text="Avocado 🥑 " />
            <outline text="Chorizo or Chicken" />
            <outline text="Bell Peppers" />
            <outline text="Grape Tomatoes" />
            <outline text="Salsa" />
            <outline text="Fiesta Cheese" />
            <outline text="1 Backlink" />
          </outline>
          <outline text="Japanese Breakfast Bowl ">
            <outline text="Ingredients">
              <outline text="Miso Soup Block" />
              <outline text="Tofu" />
              <outline text="Seaweed?" />
              <outline text="Salmon" />
              <outline text="Eggs" />
              <outline text="90 Second Instant Brown Rice (3 packs)" />
            </outline>
            <outline text="Directions">
              <outline text="Sunday Prep: ">
                <outline text="Cook Salmon" />
                <outline text="Make Miso Soup" />
              </outline>
              <outline text="Daily Prep">
                <outline text="Microwave 1/2 a bag of instant brown rice" />
                <outline text="Stir a raw egg into hot rice, whip it good." />
                <outline text="Pour a small bowl of miso soup" />
                <outline text="Grab salmon." />
              </outline>
            </outline>
          </outline>
          <outline text="Avocado Toast ">
            <outline text="Ingredients">
              <outline text="Bread" />
              <outline text="Avocados" />
              <outline text="Fresh Strawberries" />
              <outline text="Feta Cheese" />
              <outline text="Balsamic Glaze" />
            </outline>
            <outline text="Directions">
              <outline text="Toast bread" />
              <outline text="Look for half &lt;b&gt;&lt;mark class=&quot;colored c-orange&quot;&gt;Avacado&lt;/mark&gt;&lt;/b&gt; on fridge, mash it, put it on toast" />
              <outline text="Slice and place &lt;b&gt;&lt;mark class=&quot;colored c-orange&quot;&gt;strawberries &lt;/mark&gt;&lt;/b&gt;on top of toast." />
              <outline text="Sprinkle &lt;b&gt;&lt;mark class=&quot;colored c-orange&quot;&gt;feta&lt;/mark&gt;&lt;/b&gt; cheese." />
              <outline text="Drizzle &lt;b&gt;&lt;mark class=&quot;colored c-orange&quot;&gt;balsamic glaze.&lt;/mark&gt;&lt;/b&gt;" />
              <outline text="Optional: add an egg 🍳 " />
            </outline>
            <outline text="#easy #kyles_favorite " />
            <outline text="1 Backlink" />
          </outline>
          <outline text="PB &amp; Strawberry Waffles">
            <outline text="Ingredients">
              <outline text="Whole Grain Toaster Waffles" />
              <outline text="Peanut Butter" />
              <outline text="Strawberries" />
            </outline>
            <outline text="Directions">
              <outline text="Toast a waffle">
                <outline text="Heat level: 1" />
              </outline>
              <outline text="Spread peanut butter over waffle">
                <outline text="Best done while hot." />
              </outline>
              <outline text="Slice &amp; top with two strawberries" />
              <outline text="Light drizzle of maple syrup">
                <outline text="1 1/2 TSP or less." />
              </outline>
              <outline text="Pairs well with &lt;a href=&quot;https://workflowy.com/#/2e06037fa7f9&quot;&gt;Spicy Scrambled Eggs with Spinach&lt;/a&gt;" />
            </outline>
            <outline text="#easy #kyles_favorite " />
            <outline text="2 Backlinks" />
          </outline>
          <outline text="Spicy Scrambled Eggs with Spinach">
            <outline text="Ingredients">
              <outline text="Bell Pepper" _note="1/2 a bell pepper" />
              <outline text="1-2 Eggs?" />
              <outline text="Spinach" _note="Pre-cut frozen bag" />
              <outline text="Texas Pete Hot Sauce" />
            </outline>
            <outline text="Directions">
              <outline text="Breakout">
                <outline text="Bowl, fork, small pan." />
              </outline>
              <outline text="Put a handful of frozen spinach into a olive-oil lined small pan set to high heat." />
              <outline text="Add in chopped bell pepper (a half or thrird) of a bell pepper" />
              <outline text="Crack two eggs into a bowl. Pour a splash of milk into the bowl. Salt and pepper. Stir with fork." />
              <outline text="Flip the spinach (to remove ice)" />
              <outline text="Pour egg mixture into pan and reduce heat. Start scrambling with fork. (3 min?)" />
              <outline text="Turn off burner and move eggs to plate." />
              <outline text="Drizzle with Texas Pete hot sauce" />
              <outline text="Pairs well with &lt;a href=&quot;https://workflowy.com/#/5a562c66a10d&quot;&gt;PB &amp; Strawberry Waffles&lt;/a&gt;" />
            </outline>
            <outline text="#easy " />
            <outline text="1 Backlink" />
          </outline>
          <outline text="Fresh Bread (Toast) &amp; Blueberry Goat Cheese" />
          <outline text="Acai Bowl">
            <outline text="Blend ">
              <outline text="Frozen Strawberry &amp; Banana (bag)" />
              <outline text="Greek Yogurt" />
              <outline text="Acai Juice" />
            </outline>
            <outline text="Top with Granola &amp; Fruit (Blackberries, Blueberries, Raspberries), and Honey" />
            <outline text="1 Backlink" />
          </outline>
          <outline text="Banana Strawberry Smoothie" _note="with sliced apples and peanut butter (or &lt;a href=&quot;https://workflowy.com/#/5a562c66a10d&quot;&gt;PB &amp; Strawberry Waffles&lt;/a&gt;)&#10;">
            <outline text="Ingredients">
              <outline text="5-7 bananas" _note="#Sprouts&#10;" />
              <outline text="5-7 apples" _note="#Sprouts " />
              <outline text="&lt;mark class=&quot;colored c-gray&quot;&gt;--- Also ---&lt;/mark&gt;" />
              <outline text="frozen strawberries" _note="#ALDI " />
              <outline text="Peanut Butter" _note="#ALDI #Isle_1 " />
              <outline text="dry milk powder" _note="2 tbsp nonfat " />
              <outline text="turbinado raw sugar" _note="2 tbsp " />
              <outline text="pure vanilla extract" _note="1 drop " />
              <outline text="(Vanilla) Protein Powder" _note="1 tbsp, If you workout that morning &#10;" />
            </outline>
            <outline text="Directions">
              <outline text="Add all the ingredients:" _note="For best results, put the water in first and frozen items in last.">
                <outline text="1/2 cup water">
                  <outline text="About an inch of water in the smoothie mixer plastic container" />
                </outline>
                <outline text="2 tbsp turbinado raw sugar" />
                <outline text="2 tbsp nonfat dry milk powder" />
                <outline text="1 tbsp Protein Powder" _note="If you workout that morning &#10;" />
                <outline text="1 drop pure vanilla extract" _note="If you did &lt;b&gt;not &lt;/b&gt;workout this morning&#10;" />
                <outline text="1 banana" _note="broken into chucks&#10;" />
                <outline text="1 cup frozen strawberries" _note="#ALDI " />
                <outline text="1/2 cup ice" />
              </outline>
              <outline text="Blend until smooth. ">
                <outline text="Start by crushing the ice at &lt;b&gt;low speed&lt;/b&gt; for about 30 seconds." />
                <outline text="&lt;b&gt;High speed &lt;/b&gt;for another minute." />
                <outline text="If you still hear ice being crushed, it’s not ready. Keep blending! Once everything sounds like it’s smooth sailing, turn the blender off and check your smoothie. If you see a bubble pop once you stop blending, it’s ready!" />
              </outline>
              <outline text="Feel free to add ice or water depending on your desired consistency. ">
                <outline text="Too thin? Add ice for a thicker smoothie." />
                <outline text="Too thick? Just add more water." />
              </outline>
              <outline text="Slice an &lt;b&gt;apple &lt;/b&gt;and spread on the&lt;b&gt; peanut butter&lt;/b&gt;" />
            </outline>
            <outline text="#kyles_favorite " />
            <outline text="0 Backlink" />
          </outline>
          <outline text="Caprese Italian Omelet">
            <outline text="Ingredients">
              <outline text="3 Eggs" />
              <outline text="Light Mozzarella" _note="1/2 a ball.&#10;Usually come in 120 g servings, so cut in half for about 60 g&#10;" />
              <outline text="1/2 a Tomato" />
              <outline text="Fresh basil" />
              <outline text="Salt, pepper" />
            </outline>
            <outline text="Directions">
              <outline text="Crack three whole eggs into a small bowl. Salt, Stir, and set aside." _note="For best results, add salt 15 minutes before cooking." />
              <outline text="Slice Caprese Ingredients">
                <outline text="Slice Mozzarella into 4-5 thin(ish) slices." _note="Whatever a 1/2 a ball of mozzarella will yield." />
                <outline text="Slice Tomato" />
                <outline text="Chop up fresh basil" />
                <outline text="" />
              </outline>
              <outline text="Coat a medium sized pan with olive oil, set to medium heat, and pour in the eggs." />
              <outline text="Slowly break up the eggs with a spatula and tilt the pan so everything contacts bottom of the pan." _note="Repeat 2-3 times until eggs are almost done. (about a minute)&#10;">
                <outline text="" />
              </outline>
              <outline text="Add mozzarella to one side and close the lid for 20 seconds">
                <outline text="" />
              </outline>
              <outline text="Add tomatoes, basil, ground pepper &amp; close the omelete" _note="Then transfer to a plate." />
            </outline>
            <outline text="Source" _note="&lt;a href=&quot;https://www.youtube.com/watch?v=YNJ3U7AqyKU&quot;&gt;YouTube&lt;/a&gt;" />
          </outline>
          <outline text="Chicken Biscuits ">
            <outline text="Homemade-Style">
              <outline text="Ingredients">
                <outline text="Buttermilk" />
                <outline text="Butter" />
                <outline text="Fried Chicken" />
                <outline text="American Cheese" />
                <outline text="Tomatoes" />
