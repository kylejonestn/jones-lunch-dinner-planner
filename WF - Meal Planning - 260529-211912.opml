            <outline text="Chicken Apricot Panini">
              <outline text="Ingredients">
                <outline text="2 boneless chicken breasts" />
                <outline text="canola oil" _note="3 tbsp" />
                <outline text="butter" _note="6 tbsp" />
                <outline text="salt &amp; pepper" />
                <outline text="12 - 16 sage leaves" />
                <outline text="apricot preserves" _note="1/4 cup" />
                <outline text="1/4 of mayo" />
                <outline text=" french bread" _note="8 slices" />
                <outline text="1/2 a red onion" />
              </outline>
              <outline text="Directions">
                <outline text="Cut chicken breasts in half" />
                <outline text="Heat canola oil and butter" />
                <outline text="Fry sage leaves" />
                <outline text="Stir apricot preserves and mayo together" />
                <outline text="Spread mixture on bread" />
                <outline text="Add onion and sage leaves" />
                <outline text="Add chicken" />
                <outline text="Close sandwich and butter both sides" />
                <outline text="Grill sandwich" />
              </outline>
              <outline text="Source">
