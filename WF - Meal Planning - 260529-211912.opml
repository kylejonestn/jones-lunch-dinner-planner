            <outline text="Meal List" _note="&lt;time startYear=&quot;2022&quot; endYear=&quot;2022&quot; startMonth=&quot;2&quot; endMonth=&quot;2&quot; startDay=&quot;5&quot; endDay=&quot;11&quot;&gt;Sat, Feb 5, 2022 - Fri, Feb 11, 2022&lt;/time&gt; ">
              <outline text="Breakfast">
                <outline text="Ariel" />
                <outline text="Kyle">
                  <outline text="Banana Strawberry Smoothie" _note="with sliced apples and peanut butter (or &lt;a href=&quot;https://workflowy.com/#/5a562c66a10d&quot;&gt;PB &amp; Strawberry Waffles&lt;/a&gt;)&#10;" />
                </outline>
              </outline>
              <outline text="Lunch">
                <outline text="Goulash" />
              </outline>
              <outline text="Dinner">
                <outline text="&lt;time startYear=&quot;2022&quot; startMonth=&quot;2&quot; startDay=&quot;7&quot;&gt;Mon, Feb 7, 2022&lt;/time&gt; ">
                  <outline text="Zucchini Salad">
                    <outline text="Instead of &lt;a href=&quot;https://workflowy.com/#/622969f4444c&quot;&gt;Southwest Stuffed Zucchini Boats&lt;/a&gt;" />
                  </outline>
                  <outline text="Chacarero Chileno (Chilean Steak and Bean Sandwiches)">
                    <outline text="Ingredients">
                      <outline text="Kosher salt" />
                      <outline text="green beans, " _note="1/2 pound (225g), cut on a sharp bias into long, thin strips&#10;" />
                      <outline text="1 cup jarred pickled peperoncini" _note="or pickled banana peppers, with their liquid, peppers cut into rings" />
                      <outline text="skirt steak, hanger steak, or flap meat" _note="1 1/2 pounds (680g) ">
                        <outline text="If you're using hanger steak or flap meat, have the butcher butterfly the meat for you so that it is very thin. Skirt steak can be used as is." />
                      </outline>
                      <outline text="mayonnaise" _note="3/4 cup (175ml) " />
                      <outline text="minced garlic" _note="3 medium cloves&#10;" />
                      <outline text="extra-virgin olive oil" _note="3 tablespoons (45ml) " />
                      <outline text="Freshly ground black pepper" />
                      <outline text="4 sturdy rolls" _note="such as telera or ciabatta rolls" />
                      <outline text="tomato" _note="Sliced fresh " />
                    </outline>
                    <outline text="Directions" />
                    <outline text="Source" _note="&lt;a href=&quot;https://www.seriouseats.com/chacarero-chileno-steak-sandwich&quot;&gt;https://www.seriouseats.com/chacarero-chileno-steak-sandwich&lt;/a&gt;" />
                  </outline>
                  <outline text="Chapaleles">
                    <outline text="Ingredients">
                      <outline text="mashed potatoes" _note="4 cups warm " />
                      <outline text="lard" _note="1 tablespoon" />
                      <outline text="1 egg, beaten" />
                      <outline text="fried pork rinds (chicharrones)" _note="½ cup finely crushed " />
                      <outline text="all-purpose flour" _note="1 cup " />
                      <outline text="salt to taste" />
                      <outline text="vegetable oil for pan-frying" _note="2 tablespoons" />
                    </outline>
                    <outline text="Directions" />
                    <outline text="Source" _note="&lt;a href=&quot;https://www.allrecipes.com/recipe/134325/chapaleles/&quot;&gt;https://www.allrecipes.com/recipe/134325/chapaleles/&lt;/a&gt;" />
                  </outline>
                </outline>
                <outline text="&lt;time startYear=&quot;2022&quot; startMonth=&quot;2&quot; startDay=&quot;8&quot;&gt;Tue, Feb 8, 2022&lt;/time&gt; " _note="Zucchini &amp; Tomato Flatbreads">
                  <outline text="Zucchini &amp; Tomato Flatbreads " _note="with Lemon Ricotta, Basil, Honey &amp; Chili Flakes">
                    <outline text="Ingredients">
                      <outline text="1 Zucchini" _note="Small/medium. Large is too much.&#10;" />
                      <outline text="Ricotta Cheese" />
                      <outline text="Basil " />
                      <outline text="Garlic " _note="2 cloves; Pre-minced jar is okay" />
                      <outline text="Honey " />
                      <outline text="Grape Tomatoes" />
                      <outline text="Flatbreads " />
                      <outline text="Chili Flakes" _note="Spice (Optional)&#10;" />
                      <outline text="Lemon " />
                    </outline>
                    <outline text="Directions">
                      <outline text="&lt;b&gt;Prep&lt;/b&gt;">
                        <outline text="Bust out:">
                          <outline text="2 smallish bowls" />
                          <outline text="Cutting board" />
                          <outline text="tsp measuring spoon " />
                          <outline text="Knife " />
                        </outline>
                        <outline text="Wash and dry all produce. " />
                        <outline text="Trim and halve zucchini lengthwise; thinly slice crosswise into half-moons." _note="into a large pan, coated in olive oil" />
                        <outline text="Halve tomatoes (into a bowl)" />
                        <outline text="&lt;mark class=&quot;colored c-gray&quot;&gt;Mince or grate garlic. &lt;/mark&gt;" _note="Aka 1 TSP of minced garlic.&#10;" />
                        <outline text="&lt;mark class=&quot;colored c-gray&quot;&gt;Zest and &lt;/mark&gt;quarter lemon." _note="(for 4, zest 1 lemon; quarter both)" />
                      </outline>
                      <outline text="&lt;b&gt;Cook Zucchini&lt;/b&gt;">
                        <outline text="Heat a drizzle of olive oil in a &lt;b&gt;large pan&lt;/b&gt; over medium-high heat. " />
                        <outline text="Add zucchini and cook, stirring, until lightly browned and softened, 5-6 minutes. " />
                        <outline text="Season with salt and pepper. " />
                        <outline text="Turn off heat." />
                      </outline>
                      <outline text="&lt;b&gt;Marinate Tomatoes&lt;/b&gt;">
                        <outline text="Meanwhile, in a small &lt;b&gt;bowl&lt;/b&gt;, combine tomatoes, 2 cloves of minced garlic (1 tsp), and a drizzle of olive oil. " />
                        <outline text="Season with salt and pepper. " />
                      </outline>
                      <outline text="&lt;b&gt;Make Lemon Ricotta&lt;/b&gt;">
                        <outline text="Place a lightly oiled &lt;b&gt;baking sheet&lt;/b&gt; on top rack and preheat oven to 450 degrees…or 370º." _note="(for 4 servings, 2 baking sheets, on top and middle racks)" />
                        <outline text="In a &lt;b&gt;second small bowl&lt;/b&gt;, combine:">
                          <outline text="ricotta, " />
                          <outline text="½ tsp olive oil (1 tsp for 4 servings), " />
                          <outline text="and lemon juice from wedge) to taste. " />
                          <outline text="Season with salt and pepper." />
                          <outline text="&lt;i&gt;Use that TSP spoon to stir.&lt;/i&gt;" />
                        </outline>
                      </outline>
                      <outline text="&lt;b&gt;Assemble &amp; Bake Flatbreads&lt;/b&gt;">
                        <outline text="Carefully place flatbreads on prepared sheet. " _note="(divide between both prepared sheets for 4 servings)" />
                        <outline text="Evenly spread flatbreads with lemon ricotta." />
                        <outline text="Top with zucchini and tomatoes, cut sides up. " />
                        <outline text="Bake until flatbreads are golden brown, 10-12 minutes." />
                      </outline>
                      <outline text="&lt;b&gt;Finish &amp; Serve&lt;/b&gt;">
                        <outline text="Meanwhile, pick &lt;b&gt;&lt;mark class=&quot;colored c-green&quot;&gt;basil&lt;/mark&gt;&lt;/b&gt; leaves from stems; roughly tear leaves. " />
                        <outline text="&lt;mark class=&quot;colored c-gray&quot;&gt;Clean up kitchen&lt;/mark&gt;" />
                        <outline text="Once flatbreads are done, remove from oven and top with torn basil, remaining lemon zest, and chili flakes to taste. " />
                        <outline text="Drizzle with &lt;b&gt;&lt;mark class=&quot;colored c-green&quot;&gt;honey&lt;/mark&gt;&lt;/b&gt;, then slice into pieces and divide between plates. " />
                        <outline text="Serve with remaining &lt;b&gt;&lt;mark class=&quot;colored c-green&quot;&gt;lemon wedges&lt;/mark&gt; &lt;/b&gt;on the side." />
                      </outline>
                    </outline>
                    <outline text="Source">
                      <outline text="HelloFresh: &lt;a href=&quot;https://www.hellofresh.com/recipes/zucchini-and-tomato-flatbreads-5e67d93735c3537f181f43c8&quot;&gt;Web&lt;/a&gt; | &lt;a href=&quot;https://hellofresh.com/recipecards/card/zucchini-and-tomato-flatbreads-5e67d93735c3537f181f43c8-05ba09c5.pdf&quot;&gt;PDF&lt;/a&gt;" />
                    </outline>
                    <outline text="#vegetarian #kyles_favorite #easy " />
                    <outline text="0 Backlink" />
                  </outline>
                </outline>
