          <outline text="Minestrone (Soup) ">
            <outline text="Ingredients: (this makes too much) cut it in half (at least)">
              <outline text="1 onion" />
              <outline text="Carrots" />
              <outline text="4-5 celery stalks" />
              <outline text="Minced garlic" />
              <outline text="Bouillon (1 tablespoon)" />
              <outline text="Beans (rinsed)" />
              <outline text="2 cans tomato sauce" />
              <outline text="1.5 vegetable broth" />
              <outline text="Italian seasoning" />
              <outline text="Protein pasta" />
              <outline text="Green beans" />
            </outline>
            <outline text="Instructions:">
              <outline text="1. Dice the onion, " />
              <outline text="chop the carrots, " />
              <outline text="and cut 4-5 celery stalks." />
              <outline text="2. Heat olive oil in a large silver pot over high heat." />
              <outline text="3. Add the diced onion, carrots, and celery (mirepoix)." />
              <outline text="Sauté for 5 minutes." />
              <outline text="4. Add minced garlic and cook for 30 seconds until fragrant." />
              <outline text="5. Add 1 tablespoon of bouillon." />
              <outline text="6. Add rinsed beans to the pot." />
              <outline text="7. Pour in 2 cans of tomato sauce and 1.5 cans of vegetable broth." />
              <outline text="8. Add Italian seasoning." />
              <outline text="9. Bring to a boil." />
              <outline text="10. Add protein pasta and green beans." />
              <outline text="11. Cook until pasta is tender but still slightly firm (about 30 minutes total)." />
              <outline text="12. Remove from heat just before pasta is completely done to prevent mushiness." />
              <outline text="13. Let sit and serve." />
            </outline>
          </outline>
