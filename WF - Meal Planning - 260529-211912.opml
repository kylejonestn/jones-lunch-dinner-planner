              <outline text="Ingredients">
                <outline text="Sweet potatoes (3)" />
                <outline text="Bell peppers (2) green or yellow" />
                <outline text="Red onion" />
                <outline text="Chorizo or sausage" />
                <outline text="Corn tortillas" />
                <outline text="Fiesta cheese" />
                <outline text="Tomatoes" />
                <outline text="Avocados" />
                <outline text="Black Beans" />
              </outline>
              <outline text="Directions" />
            </outline>
            <outline text="Miso Peach Pork">
              <outline text="&lt;a href=&quot;https://www.hellofresh.com/recipes/miso-peach-pork-chops-63d9490a417579056e01b63a&quot;&gt;https://www.hellofresh.com/recipes/miso-peach-pork-chops-63d9490a417579056e01b63a&lt;/a&gt;" />
            </outline>
            <outline text="Chipotle Chicken and Savory Yellow Rice." _note="with Salsa Fresca and Spicy Lime Cream">
              <outline text="Ingredients">
                <outline text="1 Red Onion" />
                <outline text="2 Roma Tomatoes" />
                <outline text="1 Big Lime" />
                <outline text="Cilantro" _note="¼ ounce " />
                <outline text="Chicken Stock Concentrate" _note="1 unit / Two squirts" />
                <outline text="Sour Cream" _note="2 tablespoons" />
                <outline text="Turmeric" _note="1 teaspoon" />
                <outline text="Chipotle Powder" _note="1 teaspoon " />
                <outline text="Jasmine Rice" _note="¾ cup " />
                <outline text="Chicken Cutlets" _note="10 ounce " />
                <outline text="Also">
                  <outline text="2 tsp of Vegetable Oil" _note="Olive Oil works too" />
                  <outline text="2 tbsp of Butter" />
                  <outline text="Salt" />
                  <outline text="Pepper" />
                </outline>
              </outline>
              <outline text="Utensils">
                <outline text="Zester" />
                <outline text="Medium Pot" />
                <outline text="Large Pan" />
                <outline text="Paper Towel" />
                <outline text="Medium Bowl" />
                <outline text="Small Bowl" />
              </outline>
              <outline text="Directions">
                <outline text="One">
                  <outline text="Wash and dry all produce." />
                  <outline text=" Halve, peel, and finely dice onion. " />
                  <outline text="Dice tomato. " />
                  <outline text="Zest and quarter lime (quarter both limes for 4 servings). " />
                  <outline text="Mince cilantro leaves and stems." />
                </outline>
                <outline text="Two">
                  <outline text="Melt 1 TBSP butter (2 TBSP for 4 servings) in a medium pot over medium-high  heat. " />
                  <outline text="Add half the onion and cook until slightly softened, 1-2 minutes. " />
                  <outline text="Stir in 1¼ cups water (2¼ cups for 4), stock concentrate, ¼ tsp turmeric (½ tsp for 4; we sent more), and salt. " />
                  <outline text="Bring to a boil, then stir in ¾ cup Jasmine Rice." />
                  <outline text="Cover and reduce to a low simmer. " />
                  <outline text="Cook until rice is tender, 15-18 minutes. Keep covered off heat until ready to serve." />
                </outline>
                <outline text="Three">
                  <outline text="Pat chicken dry with paper towels; season all over with salt, pepper, and a pinch of chipotle powder (use up to ¼ tsp if you like spicy food). " />
                  <outline text="Heat a large drizzle of oil in a large pan over medium-high heat. " />
                  <outline text="Add chicken; cook until browned and cooked through, 3-5 minutes per side. (TIP: Lower heat if chipotle powder is browning too quickly.) " />
                  <outline text="Turn off heat; transfer to a cutting board." />
                </outline>
                <outline text="Four">
                  <outline text="While chicken cooks, combine tomato, cilantro, and 2 TBSP onion (3 TBSP for 4 servings) in a medium bowl (taste and add more onion if desired). Squeeze in lime juice to taste. Season with salt and pepper. Set aside, stirring occasionally, until ready to serve." />
                </outline>
                <outline text="Five">
                  <outline text="In a small bowl, combine sour cream, lime juice and zest to taste, and a pinch of chipotle powder (for an even spicier kick, use up to ¼ tsp). Season with salt and pepper." _note="Ariel doesn’t want the chipotle powder." />
                </outline>
                <outline text="Fluff rice with a fork; stir in 1 TBSP butter, half the salsa, any remaining lime zest, salt, and pepper. Divide between bowls. Slice chicken crosswise; arrange over rice. Top chicken with spicy lime cream and remaining salsa. Cut any remaining lime into wedges; serve on the side." />
              </outline>
              <outline text="Source">
                <outline text="&lt;a href=&quot;https://www.hellofresh.com/recipes/chipotle-chicken-and-savory-yellow-rice-5dadc48faad7a05b7b3a00d2&quot;&gt;https://www.hellofresh.com/recipes/chipotle-chicken-and-savory-yellow-rice-5dadc48faad7a05b7b3a00d2&lt;/a&gt;" />
              </outline>
              <outline text="#chicken " />
            </outline>
            <outline text="Mozzarella &amp; Herb Chicken" _note="with Roasted Carrots &amp; Buttery Couscous">
              <outline text="Ingredients" _note="Serves 2">
                <outline text="1 Lemon" />
                <outline text="Mozzarella Cheese" _note="1/2 cup " />
                <outline text="Chicken Breasts" _note="12 ounce " />
                <outline text="2-3 Carrots " _note="12 ounces&#10;" />
                <outline text="1 unit Chicken Stock Concentrate" />
                <outline text="Panko Breadcrumbs" _note="¼ cup " />
                <outline text="Italian Seasoning" _note="1 teaspoon&#10;" />
                <outline text="Sour Cream" _note="2 tablespoon " />
                <outline text="Israeli Couscous" _note="2.5 ounce " />
                <outline text="Also">
                  <outline text="5 teaspoon Olive Oil" />
                  <outline text="Salt &amp; Pepper" />
                  <outline text="2 tablespoon Butter" />
                </outline>
              </outline>
              <outline text="Directions">
                <outline text="Step 1">
                  <outline text="Adjust rack to top position (top and middle positions for 4 servings) and preheat oven to 425 degrees. Wash and dry all produce." />
                  <outline text="Zest and quarter lemon. Trim, peel, and cut carrots on a diagonal into ½-inch-thick pieces." />
                  <outline text="Toss carrots on one side of a baking sheet with a large drizzle of olive oil, salt, and pepper. (For 4, spread carrots out across entire sheet.)" />
                  <outline text="Roast on top rack for 5 minutes (you’ll add more to the sheet then)." />
                </outline>
                <outline text="Step 2">
                  <outline text="In a medium bowl, combine panko, mozzarella, Italian Seasoning, 1 TBSP olive oil (2 TBSP for 4 servings), salt, and pepper." />
                </outline>
                <outline text="Step 3">
                  <outline text="Pat chicken* dry with paper towels and season all over with salt and pepper." />
                  <outline text="Evenly spread sour cream onto tops of chicken, then mound with panko mixture, pressing firmly to adhere (no need to coat the undersides)." />
                </outline>
                <outline text="Step 4">
                  <outline text="Once carrots have roasted 5 minutes, remove sheet from oven. Carefully add chicken to empty side. (For 4 servings, add chicken to a second sheet; roast on middle rack.)" />
                  <outline text="Return to top rack until chicken is golden brown and cooked through and carrots are browned and tender, 15-20 minutes more." />
                </outline>
                <outline text="Step 5">
                  <outline text="Meanwhile, melt 1 TBSP butter (2 TBSP for 4 servings) in a small pot over medium-high heat. Add couscous and a pinch of salt. Cook, stirring, until toasted, 2-3 minutes." />
                  <outline text="Add ¾ cup water (1½ cups for 4) and stock concentrate. Bring to a boil, then cover and reduce to a low simmer. Cook until couscous is tender, 6-8 minutes. Turn off heat. Drain any excess liquid if necessary." />
                </outline>
                <outline text=" Step 6">
                  <outline text=" Once chicken is done, stir 1 TBSP butter (2 TBSP for 4 servings) into couscous until melted. Stir in lemon zest and lemon juice to taste; season with salt and pepper." />
                  <outline text="Divide couscous, chicken, and carrots between plates. Serve with any remaining lemon wedges on the side." />
                </outline>
              </outline>
              <outline text="Source">
                <outline text="HelloFresh" _note="&lt;a href=&quot;https://www.hellofresh.com/recipes/mozzarella-herb-chicken-5f84b616f51e756b4d1288e3&quot;&gt;https://www.hellofresh.com/recipes/mozzarella-herb-chicken-5f84b616f51e756b4d1288e3&lt;/a&gt;" />
              </outline>
              <outline text="0 Backlink" />
            </outline>
