          <outline text="&lt;b&gt;New / Never Made ✨&lt;/b&gt;">
            <outline text="Chicken Tetrazzini Casserole ">
              <outline text="&lt;a href=&quot;https://www.sixsistersstuff.com/recipe/chicken-tetrazzini-casserole-recipe/&quot;&gt;Chicken Tetrazzini Casserole Recipe - A Quick &amp; Easy Family Dinner&lt;/a&gt;" />
              <outline text="Might be a great way to make a dinner last multiple nights." />
              <outline text="#lasts_multiple_days " />
            </outline>
            <outline text="Roasted Sweet Potatoes Stuffed with Quinoa and Spinach">
              <outline text="Ingredients">
                <outline text="2 medium sized sweet potatoes" />
                <outline text="baby spinach" _note="6 cups, roughly chopped&#10;" />
                <outline text="garlic" _note="1 clove, minced" />
                <outline text="olive oil" _note="1 TBSP &#10;" />
                <outline text="1 1/2 cups of cooked quinoa" _note="Minute Ready to Serve White and Red Quinoa, 4.4 Ounces, 2 Cups" />
                <outline text="pecan pieces" _note="1/4 cup&#10;" />
                <outline text="dried cranberries" _note="1/4 cup" />
                <outline text="feta cheese" _note="1 to 2 ounces, diced&#10;" />
                <outline text="6 twists of black pepper from a pepper mill" />
                <outline text="A pinch of salt" />
              </outline>
              <outline text="Directions">
                <outline text="Cook Potatoes First">
                  <outline text="Preheat oven to 400 degrees." />
                  <outline text="Slice sweet potatoes evenly in half length wise. Coat them with a little olive oil and place face down on a parchment lined baking sheet." />
                  <outline text="Roast sweet potatoes for 30 to 40 minutes until the sweet potatoes are tender and soft." />
                </outline>
                <outline text="While you wait for the potatoes">
                  <outline text="Prep the pre-cooked quinoa per the package instructions. I usually cook quinoa in vegetable broth or add a 1/2 a bouillon cube for extra flavor." />
                  <outline text="While the sweet potatoes are roasting, add olive oil to a large sauté pan and heat over medium heat. Add garlic and half the spinach and cook until wilted and then add the rest of the spinach to the pan and cook until it’s wilted – about 4 minutes. Remove from heat." />
                  <outline text="Stir cooked quinoa, pecans, cranberries, black pepper and salt into spinach mixture." />
                  <outline text="Gently toss feta into quinoa spinach mixture." />
                </outline>
                <outline text="When sweet potatoes are ready, remove from the oven and let cool slightly. " />
                <outline text="Test for doneness – they should be soft and indent slightly when squeezed. If they are not done, put them back into the oven for an extra 5 or 10 minutes." />
                <outline text="Let the sweet potatoes cool slightly so they are easy to handle. " />
                <outline text="With a small spoon, gently press down on the center of the sweet potatoes to create a small indentation that is the length of the sweet potato." />
                <outline text="Spoon quinoa and spinach mixture evenly over sweet potatoes and serve." />
              </outline>
              <outline text="Source: &lt;a href=&quot;https://greenvalleykitchen.com/roasted-sweet-potatoes-stuffed-with-quinoa-and-spinach/&quot;&gt;Green Valley Kitchen&lt;/a&gt;" />
              <outline text="About" _note="These stuffed sweet potatoes with quinoa and spinach make a delicious and colorful entree or side dish.  Tender, healthy sweet potatoes are roasted and then topped with a flavorful mixture of quinoa, spinach, cranberries, pecans and feta cheese.&#10;&#10;" />
              <outline text="" />
              <outline text="PREP TIME: 10 MINS + COOK TIME: 40 MINS = TOTAL TIME: 50 MINUTES" />
              <outline text="YIELD: 4" />
            </outline>
            <outline text="Carrot-Thyme Soup with Cream">
              <outline text="Ingredients">
                <outline text="3 pounds Baby Carrots" />
                <outline text="2 quarts Vegetable Stock Or Chicken Stock" />
                <outline text="2 sprigs Fresh Thyme" />
                <outline text="1/3 cup Honey" />
                <outline text="1/2 cup Heavy Cream" />
                <outline text="Dash Of Salt" />
              </outline>
              <outline text="Directions">
                <outline text="Combine carrots, stock, and thyme in a pot. Bring to a boil, then reduce the heat to low and simmer for 45 minutes to 1 hour." />
                <outline text="Remove from heat and transfer soup in two batches to a blender (or you may use an immersion blender.) Puree soup completely, then stir in honey and cream. Taste, then add salt as needed." />
                <outline text="Use a little warm broth if the soup needs thinning." />
                <outline text="Serve while warm with a sprig of thyme on top." />
              </outline>
              <outline text="Source">
                <outline text="&lt;a href=&quot;https://thepioneerwoman.com/cooking/carrot-thyme-soup-with-cream/&quot;&gt;Carrot-Thyme Soup with Cream&lt;/a&gt; The Pioneer Woman" />
              </outline>
              <outline text="#soup #vegetarian " />
              <outline text="Serves 8" />
            </outline>
            <outline text="Matzah Ball Soup" />
            <outline text="Instant Pot Loaded Potato Soup">
              <outline text="Ingredients">
                <outline text="1 Tablespoon butter" />
                <outline text="1 medium onion, diced" />
                <outline text="3 cloves garlic, minced" />
                <outline text="3 cups chicken broth" />
                <outline text="1 can/box cream of chicken soup, (I prefer Pacific Foods brand)" />
                <outline text="7-8 medium sized russet potatoes, peeled and chopped into 1 inch cubes (about 2.5 pounds of potatoes)" />
                <outline text="1 1/2 teaspoons salt, (or more/less to taste)" />
                <outline text="black pepper to taste, (I like a lot of pepper)" />
                <outline text="1 cup milk" />
                <outline text="1 tablespoon flour" />
                <outline text="2 cups shredded cheddar cheese, (I use sharp cheddar)" />
                <outline text="Garnish">
                  <outline text="5-6 slices bacon, (cooked and chopped)" />
                  <outline text="sliced green onions" />
                  <outline text="shredded cheddar cheese" />
                </outline>
              </outline>
              <outline text="Directions">
                <outline text="Add butter to the Instant Pot and turn on the sauté button. Once butter is melted, add in the onions and cook for 3-4 minutes until soft. Add in the garlic and cook for one additional minute until fragrant, stirring constantly so that garlic does not burn." />
                <outline text="Add the chicken broth, cream of chicken soup, potatoes, salt, and pepper to the pot, and stir well. Place the lid on the Instant Pot and turn the vent valve to &quot;sealing.&quot; Cook over manual high pressure for 10 minutes, then quick release the pressure.">
                  <outline text="Make sure to chop your potatoes into roughly the same size for even cooking. About 1 inch cubes is what I recommend." />
                </outline>
                <outline text="Meanwhile, stir together the milk and flour in a small bowl to create a slurry. Set aside." />
                <outline text="Once the steam has completely released and the pin has dropped on the lid, open the lid and stir in the slurry. Turn the pot to sauté and cook the soup for 4-5 minutes, until thickened. Stir in the 2 cups of cheddar cheese and stir until melted. Serve garnished with chopped bacon, green onions, and more cheese. Enjoy!">
                  <outline text="If you prefer a less chunky soup, you can use an immersion blender to smooth out your soup at the end of cooking, or place the soup in a blender and blend it until it reaches the consistency you like." />
                </outline>
              </outline>
              <outline text="Source">
                <outline text="Belle of the Kitchen" _note="&lt;a href=&quot;https://belleofthekitchen.com/2018/01/11/instant-pot-loaded-potato-soup/&quot;&gt;https://belleofthekitchen.com/2018/01/11/instant-pot-loaded-potato-soup/&lt;/a&gt;" />
              </outline>
              <outline text="#soup #instant_pot " />
              <outline text="Servings: 6" />
            </outline>
            <outline text="Merlot Beef and Veggies">
              <outline text="Ingredients">
                <outline text="3 pounds Stew Beef" />
                <outline text="3 cups chunk Onion, Yellow" />
                <outline text="8 cups slice Potato, Fingerling" />
                <outline text="1 cup halve Green Beans" />
                <outline text="1 ¼ cups slice Carrot" />
                <outline text="1 teaspoon Sea Salt" />
                <outline text="1 teaspoon Black Pepper" />
                <outline text="1 teaspoon Cinnamon" />
                <outline text="2 tablespoons Apple Cider Vinegar" />
                <outline text="⅔ cups Red Wine, Merlot" />
                <outline text="½ cups Beef Bone Broth/Stock" />
              </outline>
              <outline text="Directions">
                <outline text="Place beef, onion, potatoes, green beans, carrots, salt, pepper, cinnamon, apple cider vinegar, red wine and beef broth in a slow cooker. Cook on low 5-6 hours." _note="These directions are for cooking this recipe to serve immediately and NOT to freeze for later. &#10;See &lt;a href=&quot;https://onceamonthmeals.com/recipes/merlot-beef-and-veggies/&quot;&gt;Freeze For Later&lt;/a&gt; instructions&#10;" />
              </outline>
              <outline text="Source">
                <outline text="&lt;a href=&quot;https://onceamonthmeals.com/recipes/merlot-beef-and-veggies/&quot;&gt;https://onceamonthmeals.com/recipes/merlot-beef-and-veggies/&lt;/a&gt;" />
              </outline>
              <outline text="#slow_cooker #8_servings " />
              <outline text="8 - 10 Servings" />
            </outline>
            <outline text="One Pot Garlic Parmesan Pasta">
              <outline text="Ingredients">
                <outline text="2 tablespoons unsalted butter" />
                <outline text="4 cloves garlic, minced" />
                <outline text="2 cups chicken broth" />
                <outline text="1 cup milk, or more, as needed" />
                <outline text="8 ounces uncooked fettuccine" />
                <outline text="Kosher salt and freshly ground black pepper, to taste" />
                <outline text="1/4 cup freshly grated Parmesan cheese" />
                <outline text="2 tablespoons chopped fresh parsley leaves" />
              </outline>
              <outline text="Directions">
                <outline text="Melt butter in a large skillet over medium high heat. Add garlic and cook, stirring frequently, until fragrant, about 1-2 minutes." />
                <outline text="Stir in chicken broth, milk and fettuccine; season with salt and pepper, to taste." />
                <outline text="Bring to a boil; reduce heat and simmer, stirring occasionally, until pasta is cooked through, about 18-20 minutes. Stir in Parmesan. If the mixture is too thick, add more milk as needed until desired consistency is reached." />
                <outline text="Serve immediately, garnished with parsley, if desired." />
              </outline>
              <outline text="Source">
                <outline text="Damn Delicious" _note="&lt;a href=&quot;https://damndelicious.net/2014/10/11/one-pot-garlic-parmesan-pasta/&quot;&gt;https://damndelicious.net/2014/10/11/one-pot-garlic-parmesan-pasta/&lt;/a&gt;" />
              </outline>
              <outline text="#sides #pasta " />
            </outline>
            <outline text="One-Pan Roast Turkey Breast and Root Veggies">
              <outline text="Ingredients">
                <outline text="1 lemon" />
                <outline text="6 Tbsp. unsalted butter, at room temp " />
                <outline text="4 cloves garlic, crushed with press " />
                <outline text="2 Tbsp. Dijon mustard " />
                <outline text="Kosher salt and Kosher pepper " />
                <outline text="2 (2-lb.) turkey breast halves, deboned " />
                <outline text="1 lb. med. shallots, 1 lb. halved lengthwise (left in their skins)" />
                <outline text="1 tsp. olive oil " />
                <outline text="1 lb. sm. purple potatoes (about 8), scrubbed and halved lengthwise " />
                <outline text="1 lb. sm. thin carrots (about 12), trimmed and scrubbed " />
                <outline text="12 oz. sm. parsnips. (about 4), trimmed, scrubbed and halved lengthwise" />
              </outline>
              <outline text="Directions">
                <outline text="1. Heat oven to 425°F. With vegetable peeler, remove 6 strips lemon zest, avoiding white pith; thinly slice crosswise.. In sm. bowl, combine butter, garlic, mustard, lemon zest and ½ tsp. each salt and pepper; set aside." />
                <outline text="2. Remove skin from turkey-breast halves and set aside. Rub butter mixture all over turkey breasts. Place one breast half on top of the other, arranging so 1 thick side and 1 thin side are sandwiched together. Wrap breasts in skin and tie with butcher's twine to form log shape. " />
                <outline text="3. On large rimmed baking sheet, toss shallots with oil and 1/4 tsp. each salt and pepper. Arrange them in center of sheet and place turkey on top. Roast 60 min." />
                <outline text="4. Remove from oven and transfer turkey to cutting board. Add potatoes, carrots and parsnips to baking sheet and toss with shallots and ½ tsp. each salt and pepper; arrange in even layer. Place turkey on top of vegetables and roast until turkey registers 165°F on instant-read thermometer and vegetables are golden brown and tender, 35 to 45 min. more (remove vegetables that are done before turkey)." />
                <outline text="5. Transfer turkey to clean cutting board and let rest at least 10 min. before slicing. Serve with pan juices and vegetables." />
              </outline>
              <outline text="Source: Good Housekeeping">
                <outline text="&lt;b&gt;PREP&lt;/b&gt; 30 MINUTES " />
                <outline text="&lt;b&gt;TOTAL&lt;/b&gt; 2 HOURS 25 MINUTES" />
                <outline text="SERVES 8 About 535 cals, 48 g protein, 30 g carbs, 24 g fat (9 g sat), 6 g fiber, 560 mg sodium." />
              </outline>
              <outline text="" />
            </outline>
            <outline text="Sweet 'N' Smoky Pork Tenderloin" _note="with Apple Carrot Slaw, Mashed Potatoes, and Cherry Sauce">
              <outline text="Ingredients" _note="serving 4 people">
                <outline text="2 scallions" />
                <outline text="5 tsp White Wine Vinegar" />
                <outline text="24 oz Yukon Gold Potatoes" />
                <outline text="2 tbsp Smoky Cinnamon Paprika Spice #needsattention " />
                <outline text="6 tbsp Cherry Jam" />
                <outline text="2 tbsp Mayonnaise" />
                <outline text="4 oz shredded carrots" />
                <outline text="24 oz Pork Tenderloin" />
                <outline text="1 apple" />
                <outline text="4 tbsp sour cream" />
                <outline text="Also">
                  <outline text="2 tsp olive oil" />
                  <outline text="1 tbsp butter" />
                  <outline text="Salt &amp; Pepper" />
                  <outline text="Utensils" _note="Medium Bowl • Large Pot • Strainer • Baking Sheet • Small Bowl • Potato Masher" />
                </outline>
              </outline>
              <outline text="Directions">
                <outline text="Wash and dry all produce. Adjust rack to middle position and preheat oven to 450 degrees. Trim, then thinly slice scallions. Stir together mayonnaise and 4 tsp vinegar in a medium bowl (we’ll use the rest of the vinegar later). Add carrots and toss to coat, then set aside." />
                <outline text="Cut potatoes into 1-inch pieces and place in a large pot with enough water to cover by 1 inch. Cover and bring to a boil over high heat. Once boiling, lower heat to medium. Cook until easily pierced by a knife, about 15 minutes. Scoop out and reserve ½ cup cooking water, then drain potatoes and return to pot." />
                <outline text="Rub pork with a large drizzle of olive oil. Season generously all over with salt and pepper. Set aside ½ tsp cinnamon paprika spice in a small, microwave-safe bowl, then rub pork all over with remaining spice. Place pork on a baking sheet and roast in oven to desired doneness, 18-20 minutes. Let rest 5 minutes after removing from oven." />
                <outline text="Meanwhile, quarter apple and remove core, then thinly slice. Add to bowl with carrots and toss to combine. Stir in half the scallions. Season with salt and pepper. To bowl with reserved spice, add jam, 1 tsp water, and remaining vinegar. Stir to combine. Microwave on high until warm, about 45 seconds. Add 1 TBSP butter and stir to melt. Season with salt and pepper." />
                <outline text="Mash drained potatoes in pot with a potato masher or fork until smooth. Stir in sour cream, remaining scallions, and reserved cooking water. Season with salt and pepper. TIP: For extra rich potatoes, stir in 1 TBSP butter." />
                <outline text="Slice pork crosswise, then divide between plates, along with potatoes and slaw. Drizzle sauce over pork and serve." />
              </outline>
              <outline text="" />
              <outline text="Source: HelloFresh">
                <outline text="&lt;a href=&quot;https://www.hellofresh.com/recipes/sweet-n-smoky-pork-tenderloin-5ea7100e77d519361f777cb4&quot;&gt;https://www.hellofresh.com/recipes/sweet-n-smoky-pork-tenderloin-5ea7100e77d519361f777cb4&lt;/a&gt;" />
                <outline text="Sweet 'N' Smoky Pork Tenderloin" />
              </outline>
            </outline>
            <outline text="Chicken with Mustard Cream Sauce">
              <outline text="Ingredients">
                <outline text="4 whole Boneless, Skinless Chicken Breasts" />
                <outline text="2 Tablespoons Olive Oil" />
                <outline text="2 Tablespoons Butter" />
                <outline text="3 whole Garlic Cloves, Minced" />
                <outline text="1 cup Brandy (or White Wine If Preferred)" />
                <outline text="1 Tablespoon (heaping) Dijon Mustard" />
                <outline text="1 Tablespoon (heaping) Grainy Mustard" />
                <outline text="1/4 cup (to 1/2) Heavy Cream" />
                <outline text="1/4 cup (to 1/2) Chicken Broth" />
                <outline text="Salt And Pepper, to taste" />
              </outline>
              <outline text="Directions">
                <outline text="*Amount of cream and broth has slightly decreased; add more as needed." />
                <outline text="Cut the chicken breasts in half lengthwise so that you have eight smaller, thinner chicken cutlets. Salt and pepper both sides." />
                <outline text="Heat oil and butter in a large skillet over medium-high heat. Cook cutlets on both sides until nice and golden brown and cooked through. Remove chicken from the skillet and keep on a plate." />
                <outline text="Reduce the heat to medium. Add the garlic to the pan and saute it for a minute, stirring to make sure it won't burn. Next pour in the brandy (or wine if using) being careful if cooking over an open flame. Then just let the booze bubble up and cook until it's reduced by half." />
                <outline text="Throw in the mustards and stir to combine, then pour in the cream. Stir in chicken broth, adding more if the sauce seems too thick. Taste sauce and adjust whatever you think it needs. Add chicken breasts back to the pan, nestling them into the sauce. Allow sauce to cook for another few minutes, shaking the pan if needed to move things around." />
                <outline text="Serve chicken with a green salad, spooning the sauce over the top." />
              </outline>
              <outline text="" />
              <outline text="Source: The Pioneer Woman">
                <outline text="&lt;a href=&quot;https://www.thepioneerwoman.com/food-cooking/recipes/a11646/chicken-with-mustard-cream-sauce/&quot;&gt;https://www.thepioneerwoman.com/food-cooking/recipes/a11646/chicken-with-mustard-cream-sauce/&lt;/a&gt;" />
              </outline>
            </outline>
          </outline>
          <outline text="&lt;b&gt;It's Been a While 🕔&lt;/b&gt;">
            <outline text="Pork Carnitas Tacos" _note="with Pickled Shallot and Monterey Jack Cheese">
              <outline text="Ingredients">
                <outline text="1 Shallot" />
                <outline text="1 Poblano Pepper" />
                <outline text="Cilantro" _note="¼ oz " />
                <outline text="1 Roma Tomato" />
                <outline text="1 Lime" />
                <outline text="White Wine Vinegar" _note="5 tsp " />
                <outline text="Ground Pork" _note="10 oz ">
                  <outline text="Ground Pork is fully cooked when internal temperature reaches 160 degrees" />
                </outline>
                <outline text="Fajita Spice Blend #needsattention " _note="1 TBSP  Do we sub for this usually? #ask @Ariel_Jones " />
                <outline text="1 Chicken Stock Concentrate" _note="#ask @Ariel_Jones how much we sub this for too." />
                <outline text="Tomato Paste" _note="2 TBSP " />
                <outline text="Sour Cream" _note="2 TBSP" />
                <outline text="Chipotle Powder" _note="1 tsp " />
                <outline text="6 Flour Tortillas" />
                <outline text="Monterey Jack Cheese" _note="¼ Cup " />
                <outline text="Also...">
                  <outline text="Medium bowl" />
                  <outline text="Large pan" />
                  <outline text="Slotted spoon" />
                  <outline text="Small bowl" />
                  <outline text="Paper towels" />
                  <outline text="Sugar 2 tsp" />
                  <outline text="Olive oil 2 tsp" />
                  <outline text="Kosher salt" />
                  <outline text="Black pepper" />
                </outline>
              </outline>
              <outline text="Directions">
                <outline text="Prep">
                  <outline text="Wash and dry all produce. " />
                  <outline text="Halve and peel &lt;b&gt;shallot&lt;/b&gt;. Finely chop one half; very thinly slice other half. " />
                  <outline text="Core, deseed, and dice &lt;b&gt;poblano&lt;/b&gt; into ½-inch pieces. " />
                  <outline text="Roughly chop &lt;b&gt;cilantro&lt;/b&gt;. " />
                  <outline text="Dice &lt;b&gt;tomato&lt;/b&gt;. " />
                  <outline text="Halve &lt;b&gt;lime&lt;/b&gt;; cut one half into wedges." />
                </outline>
                <outline text="Pickle Shallot">
                  <outline text="In a medium bowl, combine:">
                    <outline text="sliced shallot, " />
                    <outline text="vinegar, " />
                    <outline text="2 tsp sugar, " />
                    <outline text="½ tsp salt, " />
                    <outline text="and 1 TBSP water. " />
                  </outline>
                  <outline text="Toss until sugar and salt are mostly dissolved. " />
                  <outline text="Set aside, tossing from time to time. " />
                </outline>
                <outline text="Cook Pork">
                  <outline text="Heat a drizzle of &lt;b&gt;olive oil&lt;/b&gt; in a large pan over medium-high heat. " />
                  <outline text="Add &lt;b&gt;pork&lt;/b&gt;; season with &lt;b&gt;salt&lt;/b&gt; and &lt;b&gt;pepper&lt;/b&gt;. " />
                  <outline text="Cook, breaking up meat into pieces, until browned and cooked through, 4-5 minutes. " />
                  <outline text="Transfer to a plate using a slotted spoon. " />
                  <outline text="Pour out and discard any excess grease in pan." />
                </outline>
                <outline text="Make FIlling">
                  <outline text="Heat another drizzle of &lt;b&gt;olive oil&lt;/b&gt; in same pan over medium-high heat. " />
                  <outline text="Add &lt;b&gt;poblano&lt;/b&gt; and &lt;b&gt;chopped shallot&lt;/b&gt;; season with &lt;b&gt;salt&lt;/b&gt; and &lt;b&gt;pepper&lt;/b&gt;. " />
                  <outline text="Cook, stirring, until softened, 3-4 minutes. " />
                  <outline text="Add &lt;b&gt;pork&lt;/b&gt; to pan along with &lt;b&gt;Fajita Spice&lt;/b&gt;, &lt;b&gt;stock concentrate&lt;/b&gt;, 2 TBSP &lt;b&gt;water&lt;/b&gt;, and &lt;b&gt;half the tomato paste.&lt;/b&gt;" _note="Use all the tomato paste for 4 servings" />
                  <outline text="Cook, scraping up any browned bits on bottom, until thickened and saucy, 2-3 minutes." />
                </outline>
                <outline text="Make Crema and Warm Tortillas">
                  <outline text="In a small bowl, combine &lt;b&gt;sour cream&lt;/b&gt;, a squeeze of &lt;b&gt;lime juice&lt;/b&gt;, and a pinch of &lt;b&gt;chipotle powder&lt;/b&gt; (use more or less to taste)." />
                  <outline text="Stir in &lt;b&gt;water&lt;/b&gt;, 1 tsp at a time, until mixture reaches a drizzling consistency." />
                  <outline text="Season with &lt;b&gt;salt&lt;/b&gt; and &lt;b&gt;pepper&lt;/b&gt;." />
                  <outline text="Wrap tortillas in damp paper towels and microwave on high until warm and pliable, about 30 seconds." />
                </outline>
                <outline text="Assemble and Serve">
                  <outline text="Divide &lt;b&gt;filling&lt;/b&gt;, &lt;b&gt;tomato&lt;/b&gt;, &lt;b&gt;cheese&lt;/b&gt;, &lt;b&gt;cilantro&lt;/b&gt;, &lt;b&gt;pickled shallot&lt;/b&gt;, and &lt;b&gt;crema&lt;/b&gt; between &lt;b&gt;tortillas&lt;/b&gt;. " />
                  <outline text="&lt;i&gt;(TIP: You can put everything in individual serving bowls and let everyone assemble their own tacos.)&lt;/i&gt;" />
                  <outline text="Serve with &lt;b&gt;lime wedges&lt;/b&gt; on the side." />
                </outline>
              </outline>
              <outline text="Source">
                <outline text="HelloFresh: &lt;a href=&quot;https://www.hellofresh.com/recipes/pork-carnitas-tacos-5abd4661ae08b548c3090492&quot;&gt;Webpage&lt;/a&gt; | &lt;a href=&quot;https://ddw4dkk7s1lkt.cloudfront.net/card/pork-carnitas-tacos-5cae3fbee3f3391b557b1252-91358251.pdf&quot;&gt;PDF&lt;/a&gt;" />
              </outline>
              <outline text="#mexican #kyles_favorite #pork " />
            </outline>
            <outline text="Banh Mi-Style Burgers" _note="with Pickled Veggie Slaw, Chili Mayo &amp; Garlic Potato Wedges&#10;">
              <outline text="Ingredients" _note="2 Servings">
                <outline text="Yukon Gold Potatoes" _note="12 ounces " />
                <outline text="Carrot" _note="3 ounce " />
                <outline text="Ginger" _note="1 thumb " />
                <outline text="1 lime" />
                <outline text="Sriracha" _note="1 tsp " />
                <outline text="Garlic Powder" _note="1 tsp " />
                <outline text="2 potato buns" />
                <outline text="1 Persian Cucumber" />
                <outline text="1 red onion" />
                <outline text="cilantro" _note="1/4 oz " />
                <outline text="ground pork" _note="10 oz " />
                <outline text="mayonnaise" _note="2 TBSP " />
                <outline text="Ponzu Sauce" _note="12 milliliters" />
                <outline text="Also">
                  <outline text="Salt, Pepper, 2 tsp sugar, 4 tsp cooking oil" />
                </outline>
              </outline>
              <outline text="Directions">
                <outline text="Adjust rack to top position and preheat oven to 425 degrees. Wash and dry all produce. • Cut potatoes into ½-inch-thick wedges. Trim and thinly slice cucumber crosswise into rounds. Trim, peel, and grate carrot on the largest holes of a box grater. Roughly chop cilantro. Halve lime. Halve, peel, and thinly slice half the onion (use the rest as you like). Peel and mince ginger." />
                <outline text=" Toss potatoes on a baking sheet with half the garlic powder (you’ll use the rest later), a large drizzle of oil, salt, and pepper. • Roast on top rack until golden brown and tender, 20-25 minutes." />
                <outline text="While potatoes roast, in a medium bowl, combine cucumber, carrot, half the cilantro, juice from half the lime, 1 tsp sugar, and as much sliced onion as you like. (For 4 servings, use juice from whole lime and 2 tsp sugar.) Season with a big pinch of salt and pepper. Set aside to pickle." />
                <outline text="While potatoes roast, in a small bowl, combine mayonnaise with Sriracha to taste." />
                <outline text="In a second medium bowl, combine pork*, ginger, ponzu, remaining cilantro, remaining garlic powder, 1 tsp sugar, and ¼ tsp salt. (For 4 servings, use 2 tsp sugar and ½ tsp salt.) • Form mixture into two patties (four patties for 4), each slightly wider than a burger bun. • Heat a large drizzle of oil in a large pan over medium heat. Add patties and cook until browned and cooked through, 4-7 minutes per side." />
                <outline text="While patties cook, halve and toast buns. TIP: For a deeper flavor, toast in pan used for patties over medium heat. • Spread as much Sriracha mayo as you like onto cut sides of bottom buns. Fill buns with patties and some pickled veggie slaw. • Divide burgers between plates; serve with garlic potato wedges and remaining pickled veggie slaw on the side, with any remaining Sriracha mayo as a dipper." />
              </outline>
              <outline text="" />
              <outline text="Source">
                <outline text="HelloFresh &lt;a href=&quot;https://www.hellofresh.com/recipes/banh-mi-pork-burgers-60ae4e6491db34359f402ff0&quot;&gt;https://www.hellofresh.com/recipes/banh-mi-pork-burgers-60ae4e6491db34359f402ff0&lt;/a&gt;" />
              </outline>
            </outline>
            <outline text="(Instant Pot) Sirloin Tips in Gravy">
              <outline text="Ingredients">
                <outline text="5 lb. Sirloin Tip Roast, cubed" />
                <outline text="vegetable oil" _note="2 - 4 tablespoons " />
                <outline text="1 Onion" _note="diced" />
                <outline text="Beef Broth" _note="2 cups " />
                <outline text="Flour" _note="1/2 cup " />
                <outline text="Water" _note="1 1/2 cup " />
              </outline>
              <outline text="Directions" _note="PREP 10 min + COOK 15 min + 15 min = 40 min TOTAL">
                <outline text="Add 1 tablespoon oil to the pressure cooker pot, select Browning. When oil is hot, brown the meat in small batches, do not crowd. When all the meat is browned, add onion to pressure cooking pot and saute until tender about 3 minutes." />
                <outline text="Add browned meat and beef broth to onion in pot, cover and lock lid in place. Select High Pressure and 15 minutes cook time. When cook time ends, use a quick pressure release." />
                <outline text="Mix flour and water to make a slurry to thicken the broth. Add slurry to cooked meat and broth in pressure cooker pot. Select Browning and bring to a boil. Boil for a few minutes until broth is thickened. Add salt and pepper to taste." />
              </outline>
              <outline text="Source: Pressure Cooking Tips">
                <outline text="&lt;a href=&quot;https://www.pressurecookingtoday.com/pressure-cooker-sirloin-tips-in-gravy/&quot;&gt;https://www.pressurecookingtoday.com/pressure-cooker-sirloin-tips-in-gravy/&lt;/a&gt;" />
              </outline>
              <outline text="#beef #instant_pot " />
            </outline>
            <outline text="Lemon Butter Chicken Breasts">
              <outline text="Ingredients" _note="Servings: 6">
                <outline text="6 medium chicken breast halves" _note=" (1-1/2 pounds) boneless skinless" />
                <outline text="all-purpose flour" _note="1/2 cup " />
                <outline text="salt" _note="1/2 teaspoon " />
                <outline text="lemon pepper seasoning" _note="2 teaspoons " />
                <outline text="butter" _note="1/3 cup " />
                <outline text="2 lemons" _note="sliced" />
                <outline text="lemon juice" _note="2 tablespoons&#10;" />
                <outline text="Hot cooked rice or pilaf (optional)" />
              </outline>
              <outline text="Directions" _note="30 min">
                <outline text="Place each chicken breast half between two pieces of plastic wrap. Pound lightly into a rectangle about 1/4 to 1/8 inch thick. Remove plastic wrap. In a shallow bowl, combine the flour, salt. and lemon pepper. Coat chicken breasts with flour mixture." />
                <outline text="In a 12-inch skillet cook the chicken breasts in the hot butter, half at a time, over medium-high heat for about 3 minutes on each side or until brown and no longer pink. Remove chicken from skillet. Add lemon slices to skillet; cook for 2 to 3 minutes or until lightly browned, turning once. Return all of the chicken to the skillet, overlapping chicken breasts slightly. Drizzle lemon juice over the chicken breasts. Cook for 2 to 3 minutes more or until pan juices are slightly reduced. Serve chicken, lemon slices, and pan juices over hot cooked rice or pilaf, if desired. Makes 6 servings." />
              </outline>
              <outline text="" />
              <outline text="Source">
                <outline text="Better Homes &amp; Gardens: &lt;a href=&quot;http://www.bhg.com/recipe/poultry/lemon-butter-chicken-breasts/&quot;&gt;Lemon Butter Chicken Breasts&lt;/a&gt;" />
              </outline>
            </outline>
            <outline text="Perfect Potatoes au Gratin">
              <outline text="Ingredients">
                <outline text="4 whole russet potatoes, scrubbed clean" />
                <outline text="2 tbsp. butter, softened" />
                <outline text="1 1/2 c. heavy cream" />
                <outline text="1/2 c. whole milk" />
                <outline text="2 tbsp. flour" />
                <outline text="4 cloves garlic, finely minced" />
                <outline text="1 tsp. salt" />
                <outline text="Freshly ground pepper, to taste" />
                <outline text="1 c. Sharp cheddar cheese, freshly grated" />
              </outline>
              <outline text="Directions">
                <outline text="Preheat oven to 400 degrees." />
                <outline text="Smear softened butter all over the bottom of a baking dish." />
                <outline text="Slice potatoes, then cut slices into fourths." />
                <outline text="In a separate bowl, whisk together cream, milk, flour, minced garlic, salt, and plenty of freshly ground black pepper." />
                <outline text="Place 1/3 of the potatoes in the bottom of the baking dish. Pour 1/3 of the cream mixture over the potatoes." />
                <outline text="Repeat this two more times, ending with the cream mixture. Cover with foil and bake for 30 minutes. Remove foil and bake for 20 minutes, or until potatoes are golden brown and really bubbling. Add grated cheese to the top of the potatoes and bake for 3 to 5 more minutes, until cheese is melted and bubbly." />
                <outline text="Allow to stand for a few minutes before serving by the spoonful. Delicious!" />
              </outline>
              <outline text="Source">
                <outline text="The Pioneer Woman" _note="&lt;a href=&quot;https://www.thepioneerwoman.com/food-cooking/recipes/a11483/perfect-potatoes-au-gratin/&quot;&gt;https://www.thepioneerwoman.com/food-cooking/recipes/a11483/perfect-potatoes-au-gratin/&lt;/a&gt;" />
              </outline>
              <outline text="#sides " />
              <outline text="8 Servings" />
            </outline>
            <outline text="Za'atar Grilled Cheese ">
              <outline text="&lt;a href=&quot;https://www.hellofresh.com/recipes/zaatar-crusted-grilling-cheese-606cb42edd87867e3b30b174&quot;&gt;https://www.hellofresh.com/recipes/zaatar-crusted-grilling-cheese-606cb42edd87867e3b30b174&lt;/a&gt;" />
            </outline>
            <outline text="Turkey Feta Patties" _note="with Bulgur Greek Salad &amp; Creamy Lemon Dill Sauce">
              <outline text="Ingredients">
                <outline text="½ cup Bulgur Wheat" />
                <outline text="1 unit Chicken Stock Concentrate" />
                <outline text="1 tablespoon Turkish Spice Blend" />
                <outline text="2 unit Scallions" />
                <outline text="1 clove Garlic" />
                <outline text="1 unit Lemon" />
                <outline text="¼ ounceDill" />
                <outline text="1 unitRoma Tomato" />
                <outline text="1 unitPersian Cucumber" />
                <outline text="2 tablespoon Sour Cream" />
                <outline text="2 tablespoon Yogurt" />
                <outline text="10 ounce Ground Turkey" />
                <outline text="¼ cup Panko Breadcrumbs" />
                <outline text="2 tablespoon Soy Sauce" />
                <outline text="½ cup Feta Cheese" />
                <outline text="Also">
                  <outline text="1 teaspoon Cooking Oil" />
                  <outline text="Kosher Salt" />
                  <outline text="Pepper" />
                </outline>
              </outline>
              <outline text="Directions">
                <outline text="1 | COOK BULGUR">
                  <outline text="• In a small pot, combine bulgur, stock concentrate, 1 cup water, ½ tsp Turkish Spice, and ¼ tsp salt. (For 4 servings, use 2 cups water, 1 tsp Turkish Spice, and ½ tsp salt.) Bring to a boil, then cover and reduce to a low simmer. Cook until water has absorbed and bulgur is tender, 12-15 minutes. • Drain any excess water from bulgur and fluff with a fork. Season with salt and pepper to taste. Let cool. TIP: Spread bulgur around and up the sides of a large bowl to help it cool faster." />
                </outline>
                <outline text="2 | Prep">
                  <outline text="• Meanwhile, wash and dry produce. • Zest and quarter lemon. Pick and finely chop fronds from dill. Trim and thinly slice scallions, separating whites from greens; finely chop whites. Peel and mince or grate garlic. Dice tomato into ½-inch pieces. Trim and quarter cucumber lengthwise; slice crosswise into ½-inch-thick pieces." />
                </outline>
                <outline text="3 | Mix Sauce">
                  <outline text="• In a small bowl, combine sour cream, yogurt, half the lemon zest (all for 4 servings), half the chopped dill, and a squeeze of lemon juice. Add water 1 tsp at a time until sauce reaches a drizzling consistency. Season with salt and pepper." />
                </outline>
                <outline text="4 | Form &amp; Cook Patties">
                  <outline text="• In a large bowl, gently combine turkey*, scallion whites, soy sauce, panko, half the feta (crumble feta before adding), half the minced garlic, remaining Turkish Spice, salt (we used ½ tsp; 1 tsp for 4 servings), and pepper. (Use all the feta for 4.) Mix gently until thoroughly combined. • Form turkey mixture into 6 1½-inch meatballs (12 meatballs for 4). TIP: Rub hands with a little oil first to prevent sticking. • Heat a drizzle of oil in a large pan over medium-high heat. Add turkey meatballs; gently press down with a spatula to make ½-inch-thick patties. (For 4, cook in batches if necessary.) Cook until browned and cooked through, 2-3 minutes per side." />
                </outline>
                <outline text="5 | Mix Salad">
                  <outline text="• While turkey patties cook, add tomato, cucumber, remaining chopped dill, and a squeeze of lemon juice to bulgur. Stir to combine. Season generously with salt and pepper." />
                </outline>
                <outline text="6 | Serve">
                  <outline text="• Divide bulgur salad between plates; top with turkey patties. Drizzle patties with creamy lemon dill sauce. Garnish with scallion greens. Serve with remaining lemon wedges on the side." />
                </outline>
              </outline>
            </outline>
            <outline text="Chimichurri Pork Chops" _note="&amp; Buttery Black Beans over Rice">
              <outline text="Source" _note="HelloFresh &lt;a href=&quot;https://www.hellofresh.com/recipes/chimichurri-pork-chops-5e0a4bf3a66aa502c8058b37&quot;&gt;Web&lt;/a&gt;" />
              <outline text="0 Backlink" />
            </outline>
            <outline text="Eggplant Parmesan">
              <outline text="Ingredients">
                <outline text="2 medium eggplant  #Sprouts " _note="(about 2 1/4 pounds), cut into 1/2-inch-thick round slices" />
                <outline text="Kosher salt" _note="as needed, plus 1 tablespoon&#10;" />
                <outline text="fresh breadcrumbs #ALDI " _note="5 cups " />
                <outline text="&lt;b&gt;dried&lt;/b&gt; oregano" _note="1 tablespoon " />
                <outline text="&lt;b&gt;dried&lt;/b&gt; thyme #Sprouts " _note="1 tablespoon " />
                <outline text="Freshly ground black pepper" />
                <outline text="Vegetable oil" _note="for frying" />
                <outline text="All-purpose flour " _note="for dredging" />
                <outline text="large eggs #ALDI #isle_dairy " _note="6, beaten" />
                <outline text="whole milk " _note="2 tablespoons " />
                <outline text="Olive oil" _note="as needed" />
                <outline text="QUICK MARINARA SAUCE, &lt;a href=&quot;https://workflowy.com/#/411b27b059a0&quot;&gt;recipe follows&lt;/a&gt;" _note="7 cups " />
                <outline text="Parmesan #ALDI " _note="2/3 cup grated, divided" />
                <outline text="fresh mozzarella #ALDI " _note="1 pound,  thinly sliced &#10;" />
                <outline text="QUICK MARINARA SAUCE">
                  <outline text="extra-virgin olive oil" _note="3 tablespoons " />
                  <outline text="1/2 medium onion #Sprouts " _note="diced (about 1/3 cup)&#10;" />
                  <outline text="5 cloves garlic #Sprouts " _note="chopped" />
                  <outline text="canned tomatoes in puree #Sprouts " _note="7 cups whole, peeled,  (about two 28-ounce can), roughly chopped" />
                  <outline text="2 sprigs of fresh thyme #Sprouts " />
                  <outline text="2 sprigs of fresh basil #Sprouts " />
                  <outline text="kosher salt" _note="1 tablespoon" />
                  <outline text="Freshly ground black pepper" />
                  <outline text="1 Backlink" />
                </outline>
              </outline>
              <outline text="Directions">
                <outline text="Arrange the eggplant slices on several baking sheets and sprinkle generously all over with kosher salt. Set aside to let the bitter juices weep from the eggplant, about 1 hour." />
                <outline text="Transfer the eggplant to a colander in the sink, and rinse well under cold running water. Transfer eggplant to a work surface and blot very dry with paper towels." />
                <outline text="In a large bowl, whisk together the 1 1/2 teaspoons salt, breadcrumbs, oregano, thyme, and season with pepper." />
                <outline text="Place the flour in a medium lipped plate or bowl. In another medium bowl, whisk the egg and milk together. Dredge an eggplant slice in the flour, then dip it in the egg, and finally dredge it in the breadcrumb mixture. Shake off any excess breading and transfer the eggplant to a baking sheet. Repeat with the remaining eggplant." />
                <outline text="In a large straight-sided skillet, pour the oil to a depth of 1/2 inch. Heat the oil over medium heat until it registers 400 degrees F on a deep frying thermometer. (The oil must be heated to 400 degrees F. so that the breaded eggplant, when added, will drop the temperature of the oil to the proper frying temperature of 375 degrees F.)" />
                <outline text="Working in small batches, fry the eggplant slices, turning once, until golden brown, about 3 minutes per batch. Using tongs, transfer to a paper towel-lined baking sheet and season with salt to taste. Repeat with the remaining eggplant." />
                <outline text="Preheat the oven to 400 degrees F. Lightly brush a 15 x 10- x 2-inch-baking dish with olive oil. Cover the bottom of the baking dish with 1/3 of the marinara sauce and arrange half of the eggplant over the sauce. Cover the eggplant with another 1/3 of the sauce. Scatter half of the Parmesan and half of the mozzarella over the sauced eggplant. Repeat with the remaining eggplant, sauce, Parmesan, and mozzarella. Bake until hot and just beginning to brown, about 30 minutes. Serve immediately." />
                <outline text="QUICK MARINARA SAUCE" _note="Yield: about 3 1/2 cups">
                  <outline text="Heat the oil in a medium saucepan over medium-high heat. Saute the onion and garlic, stirring, until lightly browned, about 3 minutes. Add the tomatoes and the herb sprigs and bring to a boil. Lower the heat and simmer, covered, for 10 minutes." />
                  <outline text="Remove and discard the herb sprigs. Stir in the salt and season with pepper to taste. Use immediately, store covered in the refrigerator for up to 3 days, or freeze for up to 2 months." />
                </outline>
              </outline>
              <outline text="Source">
                <outline text="&lt;a href=&quot;https://www.foodnetwork.com/recipes/food-network-kitchen/eggplant-parmesan-recipe-2008982&quot;&gt;Food Network&lt;/a&gt;" />
              </outline>
              <outline text="#vegetarian #PrepCook_Over_an_hour #lasts_multiple_days " />
            </outline>
            <outline text="Lemon Pork Chops with Quinoa Salad">
              <outline text="Ingredients" _note="6 Servings">
                <outline text="6 - (1/2 inch thick) bone-in center-cut pork rib chops (about 4 lbs)" />
                <outline text="2 Tbsp lemon-herb seasoning" />
                <outline text="1 3/4 tsp kosher salt, divided" />
                <outline text="6 tbsp olive oil, divided" />
                <outline text="1 1/2 cups uncooked quinoa" />
                <outline text="1 (8 oz) package fresh sugar snap peas" />
                <outline text="1 garlic clove, sliced" />
                <outline text="Lemon-Carlin Vinaigrette (recipe below)" />
                <outline text="1/3 cup loosely packed fresh flat-leaf parsley leaves" />
                <outline text="1/4 cup chopped dry-roasted almonds" />
              </outline>
              <outline text="Directions">
                <outline text="Rub pork chops with herb seasoning and 1 tsp. Kosher salt. Sear half of pork in 2 1/2 tbsp hot olive oil in a large skillet over medium-high heat 4 to 5 minutes on each side or until browned and cooked through. Keep pork warm on a wire rack in a 200° oven. Repeat procedure with 2 1/2 tbsp olive oil and remaining pork. Wipe skillet clean." />
                <outline text="Bring quinoa, 1/2 tsp kosher salt, and 4 cups water to a boil in large saucepan over high heat. Cover, reduce heat to medium-low, and simmer 8 to 10 minutes or until tender; drain. Return to saucepan; cover. Let stand 10 minutes." />
                <outline text="Cut sugar snap peas in half crosswise. Heat remaining 1 tbsp olive oil in skillet over medium-high heat; cook peas in hot oil 1 minute or until bright green and tender. Sprinkle with remaining 1/4 tsp salt. Add garlic; sauté 1 minute. Remove from heat." />
                <outline text="Fluff quinoa with a fork. Add quinoa and Lemon-Garlic Vinaigrette to sugar snap pea mixture, and toss to coat. Stir in parsley and almonds. Serve with pork." />
              </outline>
              <outline text="Lemon-Garlic Vinaigrette">
                <outline text="Whisk together 2 tbsp lemon juice; 1 tbsp olive oil; 2 garlic cloves, minced; 1/4 tsp kosher salt; and 1/4 tsp black pepper" />
              </outline>
              <outline text="" />
              <outline text="Source">
                <outline text="Six o’Clock Solutions Cookbook" />
              </outline>
              <outline text="Hands-On Time: 25 Min Total Time: 35 Min" />
            </outline>
            <outline text="Cajun Fried Chicken">
              <outline text="Ingredients">
                <outline text="Brine/Chicken">
                  <outline text="sugar" _note="1/4 cup" />
                  <outline text="Worcestershire sauce" _note="3 tbsp " />
                  <outline text="hot sauce" _note="3 tbsp" />
                  <outline text="salt" _note="2 tbsp " />
                  <outline text="garlic powder" _note="1 tbsp " />
                  <outline text=" chicken pieces" _note="4 pounds" />
                </outline>
                <outline text="Creole Coating">
                  <outline text="pepper" _note="1 tbsp" />
                  <outline text="oregano" _note="1 tbsp " />
                  <outline text="garlic powder" _note="1 tbsp " />
                  <outline text="onion powder" _note="2 tsp " />
                  <outline text="cayenne pepper" _note="2 tsp " />
                  <outline text="white pepper" _note="1 tsp " />
                  <outline text="celery salt" _note="1 tsp " />
                  <outline text="flour" _note="2 cups " />
                  <outline text="vegetable oil" _note="3 quarts " />
                </outline>
              </outline>
              <outline text="Directions">
                <outline text="Combine 1 qt. water, sugar, Worcestershire, hot sauce, salt, and garlic powder in a large container until all dissolved. Submerge chicken for 1-8 hours." />
                <outline text="Combine creole seasoning and pull out 1/4 cup of the mix. Add flour to rest of mix." />
                <outline text="Use wire rack remove chicken from brine and sprinkle with 3 tbsp of spice mix and toss. Dredge chicken in flour on to wire rack." />
                <outline text="Heat oven to 200. Add oil to dutch oven about 2 inches deep and heat until 375. Cook chicken until brown and done. Place on wire rack sprinkle with remaining seasoning." />
              </outline>
              <outline text="#chicken #dutch_oven" />
            </outline>
            <outline text="Jamaican porridge">
              <outline text="&lt;a href=&quot;https://www.jamaican-recipes.com/jamaicanporridge.html&quot;&gt;https://www.jamaican-recipes.com/jamaicanporridge.html&lt;/a&gt;" />
            </outline>
