              <outline text="Baby bell peppers" />
            </outline>
            <outline text="Steps to make pita">
              <outline text="Add lettuce (shred?)" />
              <outline text="Slice tomato 🍅 (half)" />
              <outline text="Shredded carrots" />
              <outline text="Bell pepper 🫑 " />
              <outline text="Chicken " />
              <outline text="Avocado squeeze" />
              <outline text="Honey mustard" />
            </outline>
            <outline text="parse out">
              <outline text="Cherry tomatoes " />
              <outline text="Baby bell peppers " />
