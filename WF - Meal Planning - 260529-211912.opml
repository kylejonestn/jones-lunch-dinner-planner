                  <outline text="Serve with remaining lime wedges on the side for squeezing over." />
                  <outline text="" />
                </outline>
              </outline>
              <outline text="#kyles_favorite #mexican #vegetarian " />
              <outline text="" />
              <outline text="Source">
                <outline text="HelloFresh: &lt;a href=&quot;https://www.hellofresh.com/recipes/2019-w20-r8-smoky-black-bean-and-corn-tostadas-5ca4f84ee3f33978da109902&quot;&gt;Webpage&lt;/a&gt; | &lt;a href=&quot;https://hellofresh.com/recipecards/card/2019-w20-r8-smoky-black-bean-and-corn-tostadas-5ca4f84ee3f33978da109902-df387702.pdf&quot;&gt;PDF&lt;/a&gt;" />
              </outline>
