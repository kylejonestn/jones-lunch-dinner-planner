          <outline text="Kyle’s Pita Sandwich ">
            <outline text="Pull out stuff:">
              <outline text="Pitas" />
              <outline text="Grilled chicken strips" />
              <outline text="Bell pepper" />
              <outline text="Grape tomatoes " />
              <outline text="Shredded carrots" />
              <outline text="Baby Carrots" />
              <outline text="Grapes 🍇 " />
