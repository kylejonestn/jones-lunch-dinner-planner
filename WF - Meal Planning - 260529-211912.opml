              <outline text="Mini Salad" />
              <outline text="Cuties 🍊 " />
            </outline>
            <outline text="Directions">
              <outline text="Make Turkey Balls ">
                <outline text="in a large mixing bowl. Mix by hand.">
                  <outline text="ground Turkey " />
                  <outline text="Salt, pepper, Italian seasoning" />
                  <outline text="Garlic Powder" />
                  <outline text="Concentrate Bone Broth (Chicken)" />
                  <outline text="2-3 eggs" />
                </outline>
                <outline text="Cook on griddle (300 degrees)">
                  <outline text="Makes 30 meatballs." />
                </outline>
              </outline>
            </outline>
