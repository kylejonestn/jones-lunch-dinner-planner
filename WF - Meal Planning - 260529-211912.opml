            <outline text="1 cup heavy cream" />
          </outline>
          <outline text="Vanilla Bean Gelato ">
            <outline text="4 large egg yolks" />
            <outline text="1 tablespoon light corn syrup" />
            <outline text="1/4 cup + 1 tablespoon granulated sugar" />
            <outline text="1 cup heavy cream" />
            <outline text="2/3 cup whole milk" />
