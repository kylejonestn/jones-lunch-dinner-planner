              <outline text="Cook Zucchini ">
                <outline text="slice zucchini longways">
                  <outline text="Cut off both tips" />
                  <outline text="Cut in half, if desired" />
                  <outline text="Cut over pan" _note="Use a knife to guide the slices." />
                </outline>
                <outline text="Put slices in a pan with olive oil, salt, and pepper." />
                <outline text="cook for 5 min, sear." />
                <outline text="Add to lunch box, add 3 meatballs per person." />
              </outline>
              <outline text="Sauce" />
              <outline text="Parmesan Cheese" />
