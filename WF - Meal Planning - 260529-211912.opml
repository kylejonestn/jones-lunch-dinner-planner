                <outline text="Spinach " />
                <outline text="Grape Tomatoes " />
              </outline>
              <outline text="Cuties 🍊 " />
              <outline text="Yogurt " />
            </outline>
            <outline text="#Night-Before_Prep #Sunday_Meal_Prep " />
          </outline>
          <outline text="Turkey Apple Croissant Lunch">
            <outline text="Ingredients">
              <outline text="Croissant ">
                <outline text="Croissants 🥐 " _note="#aldi #Isle_1 " />
                <outline text="Laughing Cow Spread Cheese " _note="#aldi " />
                <outline text="Turkey" _note="#aldi " />
                <outline text="Granny Smith Apple 🍏 " _note="#sprouts" />
                <outline text="—" />
                <outline text="Dijon Mustard" _note="#ALDI " />
                <outline text="Knife 🔪 " />
              </outline>
              <outline text="Orange " _note="#sprouts&#10;" />
              <outline text="Pudding cup" _note=" #aldi " />
              <outline text="Baby Carrots" _note="#sprouts " />
              <outline text="Ranch " _note="#aldi #Isle_2 &#10;" />
            </outline>
            <outline text="#Night-Before_Prep" />
          </outline>
          <outline text="Black Bean Burgers" _note="with Cowboy Caviar, sweet potato, and a fruit.">
            <outline text="Black Bean Burgers">
              <outline text="Ingredients">
                <outline text="brown rice" _note="1 cup, cooked">
                  <outline text="(white will also work)" />
                </outline>
                <outline text="2x 15 oz cans black beans, rinsed" />
                <outline text=" bell pepper" _note="1/2 cup, minced" />
                <outline text="1 medium onion, minced" />
                <outline text="minced parsley" _note="2 tbsp&#10;" />
                <outline text="tomato paste " _note="1 tbsp " />
                <outline text="rolled oats, processed " _note="1/4 cup ">
                  <outline text="(In my opinion, it doesn't really matter if they are quick cook, steel cut or instant)" />
                </outline>
                <outline text="Dijon mustard " _note="1 tbsp&#10;" />
                <outline text="garlic" _note="3 cloves ">
                  <outline text="We usually have this in stock" />
                </outline>
                <outline text="powdered cumin " _note="1 1/2 tsp " />
                <outline text="Worcestershire sauce " _note="1 tbsp " />
                <outline text="2 eggs " />
                <outline text="Burger buns " _note="Optional" />
                <outline text="Butter Lettuce " />
                <outline text="Roma tomatoes 🍅 (optional)" />
                <outline text="Pickles (optional)" />
                <outline text="Sauce? #needsattention " />
                <outline text="Optional Ingredients">
                  <outline text="1 chipotle in adobo sauce" _note="optional, we leave it out" />
                  <outline text="2 tsp adobo sauce from can" _note="optional, we leave it out" />
                  <outline text="1/2 cup chopped pumpkin seeds?" _note="replacing walnuts?" />
                </outline>
              </outline>
              <outline text="Directions">
                <outline text="Prep Veggies">
                  <outline text="Bust out">
                    <outline text="1 cup measuring cup" />
                    <outline text="1/4 cup measuring cup" />
                    <outline text="3/4 cup measuring cup" />
                    <outline text="Cutting board" />
                    <outline text="Knife " />
                  </outline>
                  <outline text="Cook 1 cup of &lt;b&gt;brown rice&lt;/b&gt;" _note="Stir occasionally. ">
                    <outline text="In a medium saucepan, bring 1 cup of water to a boil." />
                    <outline text="Stir in rice. Return to boil. Reduce heat, cover and simmer for 10 minutes." />
                    <outline text="Remove from heat and stir. Fluff lightly with a fork." />
                  </outline>
                  <outline text="Process 1/4 of a cup of &lt;b&gt;oats &lt;/b&gt;in the single-serve blender to make a coarse flour like texture." />
                  <outline text="Rinse and dry two cans of &lt;b&gt;black beans&lt;/b&gt;.">
                    <outline text="Also, open a small can of tomato paste for later. 😉 " />
                    <outline text="Put 3/4 a cup of the dried black beans in a large mixing bowl." />
                    <outline text="The rest goes into the food processor." />
                  </outline>
                  <outline text="Mince 2 tsp of &lt;b&gt;parsley&lt;/b&gt;">
                    <outline text="Half goes in food processor, and the other half in the large mixing bowl." />
                  </outline>
                  <outline text="Mince 1/2 a bell pepper 🫑 and 1/2 a onion 🧅 ">
                    <outline text="These will go in a medium pan later, in a minute." />
                  </outline>
                </outline>
                <outline text="Sauté onion/pepper mixture">
                  <outline text="Start a medium sized pan over medium-high heat. ">
                    <outline text="Once hot, add 1 tbsp of coconut oil (or &lt;b&gt;olive oil&lt;/b&gt;). " />
                    <outline text="Toss in the &lt;b&gt;minced bell pepper and onion&lt;/b&gt; and sauté until the onion starts to become translucent, about 6 minutes." _note="It's okay if they char a little." />
                    <outline text="Add in 1.5 tsp of &lt;b&gt;minced garlic&lt;/b&gt; and saute another 60 seconds. " _note="Grab the 1/2 tsp measuring spoon" />
                    <outline text="Remove from heat." />
                  </outline>
                </outline>
                <outline text="Combine Ingredients">
                  <outline text="In your food processor, toss in">
                    <outline text="&lt;b&gt;&lt;i&gt;part &lt;/i&gt;&lt;/b&gt;of these ingredients" _note="The reserved parts can all be tossed in that same large mixing bowl.">
                      <outline text="black beans ✔️" _note="reserve 3/4 of a cup, if not done already." />
                      <outline text="Parsley ✔️" _note="reserve half" />
                      <outline text="(most of the) cooked brown rice" _note="Add a 1/2 a cup to the mixing bowl&#10;" />
                      <outline text="(half of the) Onion/bell pepper mixture (on stove)" _note="Add the other half to mixing bowl&#10;" />
                    </outline>
                    <outline text="&lt;b&gt;&lt;i&gt;all&lt;/i&gt;&lt;/b&gt; of the following ingredients: ">
                      <outline text="1/4 cup rolled oats, processed " />
                      <outline text="1 1/2 tsp powdered cumin " />
                      <outline text="1 tbsp tomato paste " />
                      <outline text="1 tbsp Dijon mustard " />
                      <outline text="1 tbsp Worcestershire sauce " />
                      <outline text="2 eggs " />
                    </outline>
                  </outline>
                  <outline text="Blend (until a paste forms)" _note="about 60 seconds." />
                  <outline text="Make sure the stove is off." />
                </outline>
                <outline text="Mix set-aside ingredients and bean paste">
                  <outline text="Empty the mixture into a mixing bowl with all of the reserved ingredients: ">
                    <outline text="3/4 cup beans ✔️" />
                    <outline text="1/2 cup rice ✔️?? " _note="Might still be on the stove&#10;" />
                    <outline text="1/2 parsley ✔️" />
                    <outline text="1/2 onion pepper mixture ✔️" />
                  </outline>
                  <outline text="Mix into the bean paste well to fully combine." />
                </outline>
                <outline text="Cook patties">
                  <outline text="Scoop out, and shape 8-10 patties from mixture (with ice cream scoop) onto electric griddle.">
                    <outline text="Set to 300° F" />
                  </outline>
                  <outline text="Flip every 2 minute. 4 minutes on each side?" />
                </outline>
              </outline>
            </outline>
            <outline text="Sweet Potato 🍠 " />
            <outline text="Cowboy Caviar">
              <outline text="Lima beans " />
              <outline text="Corn 🌽 " />
              <outline text="Red bell pepper 🫑 " />
            </outline>
