            <outline text="Parmesan-Crusted Chicken" _note="with Creamy Lemon Tomato Spaghetti">
              <outline text="Ingredients">
                <outline text="1 Lemon" />
                <outline text="Panko Breadcrumbs" _note="½ Cup " />
                <outline text="Fry Seasoning" _note="1 TBSP " />
                <outline text="Parmesan Cheese" _note="½ Cup" />
                <outline text="Chicken Breasts" _note="12 oz ">
                  <outline text="Chicken is fully cooked when internal temperature reaches 165 degrees." />
                </outline>
                <outline text="Dijon Mustard" _note="2 tsp " />
                <outline text="Mayonnaise" _note="2 TBSP " />
                <outline text="Spaghetti" _note="6 oz " />
                <outline text="Grape Tomatoes" _note="4 oz " />
                <outline text="2 Cloves Garlic" />
                <outline text="Cream Cheese" _note="2 TBSP " />
              </outline>
              <outline text="Directions" _note="Timed: 1 hour&#10;">
                <outline text="Prep and Mix Panko">
                  <outline text="Adjust rack to middle position and preheat oven to 450 degrees. Bring a large pot of salted water to a boil. Line a baking sheet with foil and lightly oil. Wash and dry all produce. Zest and quarter lemon. In a small bowl, combine panko, half the Fry Seasoning, half the Parmesan, and a drizzle of oil. Season with salt and pepper." />
                </outline>
                <outline text="Roast Chicken">
                  <outline text="Pat chicken dry with paper towels and place on one side of prepared baking sheet. Season all over with salt, pepper, and remaining Fry Seasoning. In a second small bowl, combine mustard and mayonnaise, then brush mixture onto tops of chicken. Sprinkle panko mixture onto brushed sides, pressing to adhere. Roast for 10 minutes." />
                </outline>
                <outline text="Cook Pasta and Season Tomatoes">
                  <outline text="Once water is boiling, add spaghetti to pot. Cook until al dente, 9-11 minutes. Reserve 1 cup pasta cooking water, then drain. Meanwhile, halve tomatoes. Mince or grate garlic. In a medium bowl, toss tomatoes with half the garlic and a drizzle of olive oil. Season with plenty of salt and pepper." />
                </outline>
                <outline text="Add Tomatoes">
                  <outline text="Once chicken has roasted 10 minutes, remove baking sheet from oven. Place seasoned tomatoes on empty side of sheet. Return to oven until tomatoes are lightly browned and softened and chicken is cooked through, 7-8 minutes. " />
                  <outline text="TIP: If tomatoes are still firm, remove chicken from sheet and roast tomatoes about a minute more." />
                </outline>
                <outline text="Toss Pasta">
                  <outline text="Melt 1 TBSP butter in pot used for pasta over medium heat. Add remaining garlic and cook until fragrant, about 1 minute. Lower heat, then add another 1 TBSP butter (2 TBSP for 4 servings), cream cheese, a pinch of lemon zest, and ¼ cup pasta cooking water. Stir until smooth. Squeeze in 1 TBSP lemon juice, then add spaghetti and toss to combine. " />
                  <outline text="TIP: Add more pasta water if needed to loosen sauce." />
                </outline>
                <outline text="Plate and Serve">
                  <outline text="Toss half the tomatoes into pot with pasta. Season with salt and pepper. Divide pasta between plates and arrange chicken to the side. Top pasta with remaining tomatoes and Parmesan. Serve with any remaining lemon wedges on the side for squeezing over." />
                </outline>
              </outline>
              <outline text="Source">
                <outline text="HelloFresh: &lt;a href=&quot;https://ddw4dkk7s1lkt.cloudfront.net/card/parmesan-crusted-chicken-5ca4f0eae3f33973683d85a2-8ef1de09.pdf&quot;&gt;PDF&lt;/a&gt;" />
              </outline>
              <outline text="#chicken " />
            </outline>
            <outline text="Tikka Masala Chicken &amp; Rice">
              <outline text="Ingredients">
                <outline text="Naan" />
                <outline text="Jasmine Rice" />
                <outline text="Chicken Breast" />
                <outline text="Tikka Masala sauce #ALDI " _note="Butter Chicken something similar sauce, " />
              </outline>
              <outline text="Directions">
                <outline text="Rice ">
                  <outline text="3/4 cups of Jasmine rice + 1 cup of water" _note="or double for more" />
                  <outline text="cook them together fluff often," />
                  <outline text="add more water if it all cooks away before the rice is tender, " />
                  <outline text="Once tender, add a tablespoon of margarine and salt while fluffing" />
                  <outline text="Time: 15 min" />
                </outline>
                <outline text="Chicken Breasts (in yellow packaging)" _note="Set out at lunch">
                  <outline text="Cut into bite size bits " />
                  <outline text="Add olive oil to pan" />
                  <outline text="Brown with salt and pepper. " _note="In a pan on high" />
                  <outline text="Once cooked (meat reaching 165 degrees)" />
                  <outline text="Add frozen peas" _note="Optional" />
                  <outline text="Add the Tikka Masala (Jar) sauce and cook for 10 mins. " />
                </outline>
                <outline text="Naan" />
              </outline>
              <outline text="Source">
                <outline text="&lt;a href=&quot;https://www.wellplated.com/instant-pot-chicken-tikka-masala/&quot;&gt;https://www.wellplated.com/instant-pot-chicken-tikka-masala/&lt;/a&gt;" />
              </outline>
              <outline text="#easy #chicken " />
              <outline text="0 Backlink" />
            </outline>
            <outline text="Szechuan Beef Noodles">
              <outline text="Ingredients" _note="servings: 4&#10;">
                <outline text="2 scallions" />
                <outline text="Shredded Red Cabbage" _note="8 oz" />
                <outline text="Sweet Soy Glaze" _note="8 tablespoons&#10;" />
                <outline text="Ramen Noodles" _note="12 oz" />
                <outline text="Ground Beef" _note="20 oz" />
                <outline text="Szechuan Paste" _note="4 tablespoons" />
                <outline text="Beef Stock Concentrate" _note="2 unit??" />
                <outline text="Sesame Seeds" _note="1 tablespoon&#10;" />
                <outline text="Also">
                  <outline text="Salt" />
                  <outline text="Sugar" _note="2 teaspoons" />
                  <outline text="Cooking Oil" _note="1 teaspoon" />
                  <outline text="Butter" _note="2 tablespoons" />
                </outline>
              </outline>
              <outline text="Directions">
                <outline text="Prep">
                  <outline text="Bring a medium pot of &lt;b&gt;salted water&lt;/b&gt; to a boil. Wash and dry produce." />
                  <outline text="Trim and thinly slice &lt;b&gt;scallions&lt;/b&gt;, separating whites from greens." />
                </outline>
                <outline text="Cook Beef Mixture">
                  <outline text="Heat a drizzle of oil in a large pan over medium-high heat. Add beef; cook, breaking up meat into pieces, until browned and cooked through, 4-6 minutes." _note="&lt;mark class=&quot;colored c-green&quot;&gt;TIP: If there’s excess grease in your pan, carefully pour it out. &lt;/mark&gt;">
                    <outline text="Ground beef is fully cooked when internal temperature reaches 160 degrees." />
                  </outline>
                  <outline text="Stir in scallion whites and cabbage; cook until tender, 2-3 minutes." />
                </outline>
                <outline text="Make Sauce">
                  <outline text="Stir in Szechuan paste, sweet soy glaze, stock concentrate, and 2 tsp sugar (1 tsp for 2 servings). Cook, stirring, until beef mixture is thoroughly coated in sauce." />
                  <outline text="Reduce heat to low." />
                </outline>
                <outline text="Finish &amp; Serve">
                  <outline text="Once water is boiling, add ²⁄3 of the noodles&lt;mark class=&quot;colored c-green&quot;&gt; (save the rest for another use)&lt;/mark&gt; to pot. Cook, stirring occasionally, until tender, 1-2 minutes. Drain and thoroughly rinse under cold water for at least 30 seconds." _note="&lt;mark class=&quot;colored c-green&quot;&gt;(This stops the cooking and helps prevent sticky noodles.)&lt;/mark&gt;" />
                  <outline text="Add drained noodles and 2 TBSP butter (1 TBSP for 2 servings) to pan with beef mixture; toss until noodles are warmed through and everything is combined, 1-2 minutes." _note="&lt;mark class=&quot;colored c-green&quot;&gt;TIP: If needed, add water a splash at a time until noodles are thoroughly coated in sauce.&lt;/mark&gt;" />
                  <outline text="Divide between bowls and top with &lt;b&gt;scallion greens&lt;/b&gt; and a &lt;b&gt;pinch of sesame seeds&lt;/b&gt;. Serve." />
                </outline>
              </outline>
              <outline text="Source: &lt;a href=&quot;https://www.hellofresh.com/recipes/szechuan-beef-noodles-62261091621b996b8428920b&quot;&gt;HelloFresh&lt;/a&gt;" />
              <outline text="#kyles_favorite #lasts_multiple_days " />
              <outline text="" />
            </outline>
            <outline text="Jamaican Jerk Chicken">
              <outline text="Ingredients">
                <outline text="chicken thighs " _note="3 lbs boneless, skinless #ALDI #freezer " />
                <outline text="1 bell pepper " _note="sliced #Sprouts &#10;" />
                <outline text="1 red onion, " _note="sliced #Sprouts " />
                <outline text="black beans " _note="15 ounces,  (salt-free if you can find them) (drain &amp; rinse) #ALDI #Isle_2 &#10;" />
                <outline text="corn " _note="15 ounces #ALDI #Isle_2 &#10;" />
                <outline text="Sauce">
                  <outline text="water" _note="1/2 cup " />
                  <outline text="honey " _note="1/4 cup " />
                  <outline text="Juice of 1 lime" _note="#Sprouts " />
                  <outline text="extra-virgin olive oil" _note="1 tbsp " />
                  <outline text="3 garlic cloves" _note="minced" />
                  <outline text="salt" _note="2 tsp " />
                  <outline text="red pepper flakes" _note="1/2 tsp " />
                  <outline text="cinnamon" _note="1/2 tsp " />
                  <outline text="cumin" _note="1/2 tsp " />
                </outline>
              </outline>
              <outline text="Directions">
                <outline text="Add chicken, bell pepper, black beans, corn and onion to the slow cooker." />
                <outline text="In a small bowl, mix together sauce ingredients." />
                <outline text="Pour sauce in to the slow cooker." />
                <outline text="Stir to mix well." />
                <outline text="Cook HIGH 3-4 or LOW 6-8 in slow cooker." />
              </outline>
              <outline text="Source: &lt;a href=&quot;https://fitslowcookerqueen.com/slow-cooker-jamaican-jerk-chicken/&quot;&gt;https://fitslowcookerqueen.com/slow-cooker-&lt;/a&gt;&lt;a href=&quot;https://fitslowcookerqueen.com/slow-cooker-jamaican-jerk-chicken/&quot;&gt;jama&lt;/a&gt;&lt;a href=&quot;https://fitslowcookerqueen.com/slow-cooker-jamaican-jerk-chicken/&quot;&gt;ican-jerk-chicken/&lt;/a&gt;" />
              <outline text="#lasts_multiple_days #slow_cooker #6_servings #PrepCook_Over_an_hour #soup" />
              <outline text="" />
              <outline text="1 Backlink" />
            </outline>
            <outline text="Tortellini Pasta &amp; Salad">
              <outline text="Ingredients">
                <outline text="Tortellini/Ravioli Pasta #Sprouts ">
                  <outline text="Refrigerated" />
                </outline>
                <outline text="Marinara Sauce #ALDI " />
                <outline text="Salad Mix #Sprouts " />
              </outline>
